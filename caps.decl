# mkdir -- caps.decl
#
# Wave: R50 -> v1.1-A extraction
# Doc:  design/architecture.md (v1.1-A section) in this repo;
#       design/user/syscall-table.md row 79 in paideia-os.
#
# v1.1-A takes NO caps at exec. The tool's create primitive is the
# plain `sys_mkdir` syscall (sysno 79) which is @{fs}-gated at the
# effect-system level but does not thread through the KIND_PDXFS_*
# capability subsystem -- the kernel-side sys_mkdir_body walks its
# path argument against the mount tree via `mount_root_vnode +
# path_resolve`, not via a KIND_PDXFS_TXN row seeded by the shell.
#
# What v1.1-A retires from M1..M5
# -------------------------------
#
# The M5-era declaration required five cap rows (slots 0..4):
#
#   slot 0 : KIND_PDXFS_TXN     (INVOKE|OBSERVE) -- pre-opened TXN
#   slot 1 : KIND_PDXFS_FILE    (INVOKE)         -- target parent
#   slot 2 : KIND_USER          (INVOKE)         -- owner tail stamp
#   slot 3 : KIND_IPC_ENDPOINT  (WRITE|INVOKE)   -- semantic pipe
#   slot 4 : KIND_IPC_ENDPOINT  (WRITE|INVOKE)   -- audit journal
#
# Every one of those was consumed by placeholder `sys_cap_invoke`
# ops that never actually created a directory, staged the
# CreatedDirRecord/RmdirUndoRecord shapes, or reached a real
# libpdx-audit consumer (grep-verified never linked; see
# design/enhancement-plan.md §3.7 and §3.6). v1.1-A retires the
# scaffold and its cap surface together -- see
# `src/mkdir.pdx` header for the file-by-file retirement inventory.
#
# The audit-journal seam re-enters as a real dependency when the
# next wave rebuilds it on top of libpdx-audit's marshaller (issue
# not yet filed; documented as a v1.2-A follow-up).
#
# The `_init_caps` sidecar in `src/mkdir.pdx` is likewise dropped
# at v1.1-A: with `requires:` empty the loader's
# `init_caps_validate` (paideia-os src/kernel/core/loader/
# init_caps.pdx) has nothing to check, matching every
# capability-free /bin coreutil in the paideia-os user tree
# (`src/user/true.pdx`, `src/user/cat.pdx`, `src/user/mkdir.pdx`,
# etc. -- none carry an `_init_caps` array).

requires: []

# Declared output schemas
# -----------------------
#
# v1.1-A emits no typed records. The M5-era
# `CreatedDirRecord@0.1` (handle 0x0100000100010001) had no
# consumer in the ecosystem anyway (`libpdx-semantic-pipe
# send_record` grep-verified zero call sites); v1.2-A relands the
# emit against a live consumer, together with the audit-journal
# hookup above.

declares_output_schemas: []
