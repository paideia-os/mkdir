# mkdir — caps.decl
#
# Wave: R50
# Doc:  design/tooling/r49-r50-plan.md §4.9 + §5.9 in the paideia-os repo.
#
# mkdir is a coreutil that opens a KIND_PDXFS_TXN, creates one or more
# directories under a target parent, writes the invoker's KIND_USER cap
# as the created inode's cap-tail owner, and commits. Every op takes
# place within the invoker's own subtree — mkdir has NO libpdx-elevate
# dependency at v1.0 (see §5.9 "no elevate dependency" line).
#
# Every cap listed here MUST arrive via the loader's InitCap sidecar
# (src/kernel/core/loader/init_caps.pdx in paideia-os): mkdir's
# `_init_caps` array in src/mkdir.pdx is validated at image-load time
# by `init_caps_validate` (design/loader/init-caps-sidecar.md §4 in
# paideia-os), which mints each declared row directly into the task's
# kernel-side cap_table before `_start` runs.
#
# mkdir.ENH-008 correction: earlier revisions of this file claimed
# "cap_manifest_verify (libpdx-cap M2-001) runs at _start against THIS
# FILE'S declaration and refuses any cap not named below." That is not
# what happens. `cap_manifest_verify` is a libpdx-cap userspace
# primitive (decl-vs-received Cap[] wire-array compare); mkdir's
# `_start` never calls it, and — as of this correction — no confirmed
# call site anywhere in the ecosystem produces the "received Cap[]
# wire array" argument it needs for a spawned coreutil like mkdir (the
# shell's own exec path, src/exec.pdx `exec_narrow_child_caps`,
# performs its own inline parent/child narrowing rather than calling
# cap_manifest_verify). The actual enforcement point for mkdir's five
# caps is the kernel loader's InitCap validator named above, which
# checks slot range and known-kind membership at load time — not a
# declared-vs-received identity check against this file's text.
#
# M1 seeds four slots via the sidecar (see src/mkdir.pdx _init_caps
# layout); M3-002 (see below) added a fifth for the audit-journal
# endpoint. M2 layers the -p multi-level TXN atomicity on top; the cap
# set does not otherwise grow.
requires:
  # slot 0 — KIND_PDXFS_TXN. One TXN per mkdir invocation. Under -p
  # every level created lives inside this one TXN so an abort mid-create
  # leaves zero new directories on disk (M4-003 acceptance).
  - kind: KIND_PDXFS_TXN
    rights: R_PDXFS_TXN_INVOKE | R_PDXFS_TXN_OBSERVE
    slot: 0

  # slot 1 — KIND_PDXFS_FILE(write) over the target parent directory
  # inode. Every created child inherits from this parent's cap chain;
  # the derivation gate for KIND_PDXFS_FILE (kind_pdxfs_file.pdx
  # dispatch) enforces that a mint request never widens the parent's
  # byte reach. M1 exercises the invoke path only against DEBUG_PRINT
  # (ordinal 6) as a placeholder until the create-dir op lands
  # kernel-side per the M2 substrate follow-up.
  - kind: KIND_PDXFS_FILE
    rights: R_PDXFS_FILE_INVOKE
    slot: 1

  # slot 2 — KIND_USER. The invoker's user cap. Recorded verbatim into
  # each created directory's cap tail so `ls --long` (libpdx-cap M3-001)
  # can render the owner. M1 stores the cap-slot number only; M2 wires
  # the sign-inode helper (libpdx-cap M3-002) that stamps the inode
  # against the invoker's user_sk when the vault is unlocked.
  - kind: KIND_USER
    rights: R_USER_INVOKE
    slot: 2

  # slot 3 — KIND_IPC_ENDPOINT (semantic pipe). Bound at M3-001 to the
  # `CreatedDirRecord@0.1` schema via libpdx-semantic-pipe; used at M1
  # only as an untyped stderr sink through sys_debug_puts (SC+ ID 12)
  # while libpdx-semantic-pipe.M2 lands. The M3 rewrite replaces every
  # sys_debug_puts call site with a schema-tagged send_record; the cap
  # slot and its declared rights do not change.
  - kind: KIND_IPC_ENDPOINT
    rights: R_IPC_WRITE | R_IPC_INVOKE
    slot: 3

  # slot 4 — KIND_IPC_ENDPOINT (audit journal, svc.audit-journal).
  # mkdir.ENH-008: this row was missing even though _init_caps entry 4
  # (src/mkdir.pdx) has declared it since M3-002 and manifest.pdxsig
  # [capabilities] has listed it since M5-001 — the audit cap mkdir
  # invokes on every single invocation (emit_audit_event, TOOL_INVOKE /
  # TOOL_ERROR) was simply absent from this file's `requires:` list.
  # Bound at spawn time by the shell to the registered audit-journal
  # broker (src/kernel/core/ipc/audit_journal_broker.pdx); mkdir treats
  # it as write-only.
  - kind: KIND_IPC_ENDPOINT
    rights: R_IPC_WRITE | R_IPC_INVOKE
    slot: 4

# Declared output schemas — mkdir emits CreatedDirRecord[] on the
# semantic pipe at slot 3 (M3-001 wire-up). Per I4 in
# design/tooling/plan.md, mkdir's text layer is stderr-only: -v mode
# and every error prints a one-line diagnostic; the primary output is
# the schema stream. The schema handle format matches libpdx-argv's
# PdxArgvParsed declaration (schema_id@version).
declares_output_schemas:
  - CreatedDirRecord@0.1
