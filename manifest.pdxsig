%git   b12b264344e83ac51074c4f72233ff2f2ee4d8de
%plan  design/tooling/plan.md §D4 + §6.4 (paideia-os)

# manifest.pdxsig — mkdir 1.0.0 dual-signed release manifest
#
# Layout per design/tooling/plan.md §D4:
#   1. [manifest]      header + per-file content-hash table (below)
#   2. [author-sig]    ML-DSA-65 signature over §1 under author_pk
#   3. [paideia-sig]   ML-DSA-65 signature over §1 under paideia_root_pk
#
# The two signatures cover the manifest body — NOT the tool source
# files directly. A verifier re-computes the content hash of each file
# named in §1 and rejects the package on any mismatch. This gives the
# same tamper-evidence as a Merkle root but avoids the cost of a
# balanced-tree walk at every `pkg install`.
#
# The signature blocks below carry PLACEHOLDER bytes at v1.0 —
# author_pk and paideia_root_pk are not yet stood up (T-INFRA-001 +
# T-INFRA-002 in design/tooling/plan.md §10). At M5-002 mirror-push
# time the paideia-signing-bot replaces both blocks with real
# ML-DSA-65 signatures. The manifest body (§1) is byte-frozen at v1.0
# — the signing bot MUST NOT rewrite §1 during re-sign or the hash
# chain breaks.

# ============================================================================
# §1  [manifest] — per-file SHA-256 hash table
# ============================================================================
#
# Format:  <sha256-hex>  <path>
#
# Path is repository-relative. Order is stable (git-alphabetical by
# path) so a byte-diff between two manifests localises exactly which
# file changed. Every file that ships in `pkg.tar` at M5-002 has one
# row here; nothing else is in the package.

[manifest]
1fe6718ff07eb675fffdab27f0966945d6e2dcb8c1054e370e3612a066e19a3d  src/mkdir.pdx
2f7e3524e255084125352d28b7d9c3413f1a1a8608f9d86cdbcefa1e6a88fae9  src/mkdir_state.pdx
72bbf78fa1d656e689e5a98336c94cf7fc3f027ea145a3bcc68f5c3fd2eb924d  tests/test_m4_001_single_multi.pdx
