[capabilities]
# Copied verbatim from caps.decl for the fast-path verifier (`pkg
# verify --caps-only`). Row shape:  slot  kind  rights
0  KIND_PDXFS_TXN      R_PDXFS_TXN_INVOKE|R_PDXFS_TXN_OBSERVE
1  KIND_PDXFS_FILE     R_PDXFS_FILE_INVOKE
2  KIND_USER           R_USER_INVOKE
3  KIND_IPC_ENDPOINT   R_IPC_WRITE|R_IPC_INVOKE
4  KIND_IPC_ENDPOINT   R_IPC_WRITE|R_IPC_INVOKE

[schemas]
CreatedDirRecord@0.1

[deps]
libpdx-argv@1.0.0
libpdx-cap@1.0.0
libpdx-audit@1.0.0
libpdx-semantic-pipe@1.0.0

# ============================================================================
# §2  [author-sig] — ML-DSA-65 signature under author_pk
# ============================================================================
#
# author_pk fingerprint (BLAKE3-256 truncated to 16 hex chars):
#   PLACEHOLDER_AUTHOR_FP__________
#
# The signature covers the CANONICAL byte encoding of §1: every line
# between the `[manifest]` marker (exclusive) and the `[author-sig]`
# marker (exclusive), LF-terminated, ASCII-only.
#
# ML-DSA-65 signatures are 3293 bytes → 4392 base64 chars → laid out
# 64 chars per line. The placeholder below has the same LINE COUNT as
# a real signature so a diff between placeholder and real reveals only
# content changes, not layout changes.

[author-sig]
PLACEHOLDER_AUTHOR_SIGNATURE_v1_0_0_mkdir_M5_001________________
PLACEHOLDER_AUTHOR_SIGNATURE_v1_0_0_mkdir_M5_001________________
PLACEHOLDER_AUTHOR_SIGNATURE_v1_0_0_mkdir_M5_001________________
PLACEHOLDER_AUTHOR_SIGNATURE_v1_0_0_mkdir_M5_001________________
PLACEHOLDER_AUTHOR_SIGNATURE_v1_0_0_mkdir_M5_001________________

# ============================================================================
# §3  [paideia-sig] — ML-DSA-65 signature under paideia_root_pk
# ============================================================================
#
# paideia_root_pk fingerprint (BLAKE3-256 truncated to 16 hex chars):
#   PLACEHOLDER_PAIDEIA_ROOT_FP____
#
# The signature covers the SAME canonical byte range as §2. Independent
# ML-DSA-65 key; the R32 root key material is generated once and held
# on the paideia-signing-bot host (T-INFRA-002).
#
# `pkg install` verifies BOTH signatures against the manifest body
# under the fingerprint pinned in the client's `/pkgs/roots.pdx` file.
# Either verification failure rejects the package with exit code 5
# (I3 shared exit-code convention).

[paideia-sig]
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_0_0_mkdir_M5_001__________
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_0_0_mkdir_M5_001__________
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_0_0_mkdir_M5_001__________
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_0_0_mkdir_M5_001__________
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_0_0_mkdir_M5_001__________

# EOF — end of dual-signed manifest for mkdir 1.0.0
