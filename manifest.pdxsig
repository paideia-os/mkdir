%pdxsig 0.1
%tool  mkdir
%ver   1.2.0
%wave  R50 + R90-XREPO.013.M3-006 + R107-M0-001
%git   b12b264344e83ac51074c4f72233ff2f2ee4d8de
%plan  design/tooling/plan.md §D4 + §6.4 (paideia-os);
%plan  design/round-retrospectives/r90-xrepo-wave3-plan.md §R90-XREPO.013.M3-006 (paideia-os).

# manifest.pdxsig — mkdir 1.2.0 dual-signed release manifest
#
# Layout per design/tooling/plan.md §D4:
#   1. [manifest]      header + per-file content-hash table (below)
#   2. [author-sig]    ML-DSA-65 signature over §1 under author_pk
#   3. [paideia-sig]   ML-DSA-65 signature over §1 under paideia_root_pk
#
# The two signatures cover the manifest body — NOT the tool source
# files directly. A verifier re-computes the content hash of each file
# named in §1 and rejects the package on any mismatch. This gives the
# same tamper-evidence as a Merkle root but avoids the cost of a
# balanced-tree walk at every `pkg install`.
#
# The signature blocks below carry PLACEHOLDER bytes at v1.0 —
# author_pk and paideia_root_pk are not yet stood up (T-INFRA-001 +
# T-INFRA-002 in design/tooling/plan.md §10). At M5-002 mirror-push
# time the paideia-signing-bot replaces both blocks with real
# ML-DSA-65 signatures. The manifest body (§1) is byte-frozen at v1.0
# — the signing bot MUST NOT rewrite §1 during re-sign or the hash
# chain breaks.

# ============================================================================
# §1  [manifest] — per-file SHA-256 hash table
# ============================================================================
#
# Format:  <sha256-hex>  <path>
#
# Path is repository-relative. Order is stable (git-alphabetical by
# path) so a byte-diff between two manifests localises exactly which
# file changed. Every file that ships in `pkg.tar` at M5-002 has one
# row here; nothing else is in the package.

[manifest]
# v1.2.0 body (M5-era hash rows retired at v1.1-A; the current
# per-file SHA-256 table is regenerated at signing-bot time per
# design/tooling/plan.md §D4). Placeholder rows below name the
# v1.2.0 file inventory only — the SHA-256 columns are recomputed
# on the next signed release cut by the paideia-signing-bot.
PLACEHOLDER_SHA256_v1_2_0_mkdir_src_mkdir_pdx_______________________  src/mkdir.pdx
PLACEHOLDER_SHA256_v1_2_0_mkdir_src_tool_ident_pdx__________________  src/tool_ident.pdx
PLACEHOLDER_SHA256_v1_2_0_mkdir_tests_mk_dot_smoke_pdx______________  tests/mk_dot_smoke.pdx
PLACEHOLDER_SHA256_v1_2_0_mkdir_tests_README_md_____________________  tests/README.md
PLACEHOLDER_SHA256_v1_2_0_mkdir_caps_decl___________________________  caps.decl
PLACEHOLDER_SHA256_v1_2_0_mkdir_deps_list___________________________  deps.list
PLACEHOLDER_SHA256_v1_2_0_mkdir_doc_mkdir_pdxdoc____________________  doc/mkdir.pdxdoc
PLACEHOLDER_SHA256_v1_2_0_mkdir_LICENSE_____________________________  LICENSE
PLACEHOLDER_SHA256_v1_2_0_mkdir_README_md___________________________  README.md
PLACEHOLDER_SHA256_v1_2_0_mkdir_VERSION_____________________________  VERSION
PLACEHOLDER_SHA256_v1_2_0_mkdir_design_architecture_md______________  design/architecture.md
PLACEHOLDER_SHA256_v1_2_0_mkdir_design_enhancement_plan_md__________  design/enhancement-plan.md

[capabilities]
# Copied verbatim from caps.decl for the fast-path verifier (`pkg
# verify --caps-only`). v1.2.0 (paideia-os/mkdir#28) narrows to
# the R90-XREPO.013.M3-006 adoption profile: KIND_PDXFS_VOL for
# the mkdir syscall path and KIND_IPC_ENDPOINT for the v1.2.0
# MkdirRecord@0.1 emit substrate. The five M5-era rows retired at
# v1.1-A (KIND_PDXFS_TXN / KIND_PDXFS_FILE / KIND_USER + two
# KIND_IPC_ENDPOINT slots) are NOT re-added at v1.2.0.
0  KIND_PDXFS_VOL      R_PDXFS_VOL_MKDIR
1  KIND_IPC_ENDPOINT   R_IPC_WRITE

[schemas]
# v1.2.0 (paideia-os/mkdir#30): MkdirRecord@0.1 emit via
# sys_semantic_send (SC+ ID 115). CreatedDirRecord@0.1 remains
# retired from v1.1-A (its M5-era producer/consumer pair had no
# live wiring). MkdirRecord@0.1 replaces it as the canonical
# per-invocation record shape.
MkdirRecord@0.1

[deps]
# v1.2.0 satellite dependency set. The M5-era pins (libpdx-argv
# @1.0.0, libpdx-cap @1.0.0, libpdx-audit @1.0.0,
# libpdx-semantic-pipe @1.0.0) were all grep-verified NEVER
# linked and retired at v1.1-A per deps.list §"Retired from
# M5-era pins". v1.2.0 remains dependency-free: the record emit
# goes through the raw sys_semantic_send syscall (SC+ ID 115) —
# the libpdx-semantic-pipe fd-bind path would land as a follow-up
# only if a shell.M3 pipe-plumbing wire-in re-enters the design.
(intentionally empty at v1.2.0)

# ============================================================================
# §2  [author-sig] — ML-DSA-65 signature under author_pk
# ============================================================================
#
# author_pk fingerprint (BLAKE3-256 truncated to 16 hex chars):
#   PLACEHOLDER_AUTHOR_FP__________
#
# The signature covers the CANONICAL byte encoding of §1: every line
# between the `[manifest]` marker (exclusive) and the `[author-sig]`
# marker (exclusive), LF-terminated, ASCII-only.
#
# ML-DSA-65 signatures are 3293 bytes → 4392 base64 chars → laid out
# 64 chars per line. The placeholder below has the same LINE COUNT as
# a real signature so a diff between placeholder and real reveals only
# content changes, not layout changes.

[author-sig]
PLACEHOLDER_AUTHOR_SIGNATURE_v1_2_0_mkdir_wave_E________________
PLACEHOLDER_AUTHOR_SIGNATURE_v1_2_0_mkdir_wave_E________________
PLACEHOLDER_AUTHOR_SIGNATURE_v1_2_0_mkdir_wave_E________________
PLACEHOLDER_AUTHOR_SIGNATURE_v1_2_0_mkdir_wave_E________________
PLACEHOLDER_AUTHOR_SIGNATURE_v1_2_0_mkdir_wave_E________________

# ============================================================================
# §3  [paideia-sig] — ML-DSA-65 signature under paideia_root_pk
# ============================================================================
#
# paideia_root_pk fingerprint (BLAKE3-256 truncated to 16 hex chars):
#   PLACEHOLDER_PAIDEIA_ROOT_FP____
#
# The signature covers the SAME canonical byte range as §2. Independent
# ML-DSA-65 key; the R32 root key material is generated once and held
# on the paideia-signing-bot host (T-INFRA-002).
#
# `pkg install` verifies BOTH signatures against the manifest body
# under the fingerprint pinned in the client's `/pkgs/roots.pdx` file.
# Either verification failure rejects the package with exit code 5
# (I3 shared exit-code convention).

[paideia-sig]
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_2_0_mkdir_wave_E__________
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_2_0_mkdir_wave_E__________
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_2_0_mkdir_wave_E__________
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_2_0_mkdir_wave_E__________
PLACEHOLDER_PAIDEIA_ROOT_SIGNATURE_v1_2_0_mkdir_wave_E__________

# EOF — end of dual-signed manifest for mkdir 1.2.0
