// tests/test_enh_multi_positional.pdx — mkdir.ENH-012
// TestEnhMultiPositional module: multi-positional coreutil test driver.
//
// Per design/enhancement-plan.md §5 ENH-012 fingerprint (a):
//   "mkdir a b c -> one TXN, three record pairs at indices 0..2, exit 0."
//
// This is the regression test the M4 matrix was missing: every M4-*
// driver invokes mkdir_run with exactly one positional (argc of 1, or
// 2 for `-p` + one path). That gap is exactly why the mkdir.ENH-006
// double-commit + record-clobber bugs shipped inside a green M4 —
// `mkdir a b c` is the first invocation shape in this repo's test
// matrix with more than one positional.
//
// Scenario: `mkdir a b c` (three single-letter positionals, no flags).
// Before mkdir.ENH-006, this invocation double-committed (positional
// `b`'s mkdir_one call issued its own PXT_OP_COMMIT against the
// already-COMMITTED shared TXN row and returned MK_TXN_COMMIT_FAIL)
// and clobbered records (newly_created_count reset to 0 at the top of
// every mkdir_one call meant `b`'s CreatedDirRecord overwrote `a`'s at
// index 0). After mkdir.ENH-006, mkdir_run opens ONE TXN, calls
// mkdir_one three times (each appending to a running
// newly_created_count), and commits ONCE.
//
// Test driver convention (per tests/README.md, established at M4-001):
//   1. mkdir_state_reset() + reset() (libpdx-argv ParsedArgs).
//   2. Seed bootstrap argv over own .rodata strings.
//   3. parse_argv -> parse_flags_from_argv -> mkdir_run.
//   4. Assert MkdirState singletons + record fields via cmp against
//      expected values.
//   5. Emit fixed OK witness on all-pass, per-check FAIL diagnostic +
//      return 1 on any deviation.
//
// paideia-as conformance mirrors src/mkdir.pdx / tests/test_m4_*.pdx:
//   - Module name PascalCase basename (`TestEnhMultiPositional`).
//   - No `test` mnemonic — every zero-check is `cmp reg, 0`.
//   - r11 scratch only (LEA); every `cmp reg, imm` uses an immediate
//     well under 0x7FFFFFFF (max seen: 80, a CreatedDirRecord byte
//     offset).
//   - Labels prefixed `tep_` (test-enh-positional) to avoid every
//     paideia-as reserved keyword.
//   - Straight-line driver, zero callee-save state, no push/pop parity
//     needed (matches every M4 driver).
//
// Upstream: design/enhancement-plan.md §5 (ENH-012), design/tooling/
// r49-r50-plan.md §5.9 (paideia-os).

module TestEnhMultiPositional = structure {

  // ============================================================================
  // Witness strings.
  // ============================================================================

  pub let ok_multipos_msg : [u8; 35] = "mkdir.ENH-012 multi-positional OK\n\0"
  pub let ok_multipos_len : u64 = 34

  pub let fail_multipos_rc_msg : [u8; 32] = "mkdir.ENH-012 multipos FAIL rc\n\0"
  pub let fail_multipos_rc_len : u64 = 31

  pub let fail_multipos_newly_created_msg : [u8; 49] =
    "mkdir.ENH-012 multipos FAIL newly_created_count\n\0"
  pub let fail_multipos_newly_created_len : u64 = 48

  pub let fail_multipos_cdr_count_msg : [u8; 39] =
    "mkdir.ENH-012 multipos FAIL cdr_count\n\0"
  pub let fail_multipos_cdr_count_len : u64 = 38

  pub let fail_multipos_rur_count_msg : [u8; 39] =
    "mkdir.ENH-012 multipos FAIL rur_count\n\0"
  pub let fail_multipos_rur_count_len : u64 = 38

  pub let fail_multipos_path_len_msg : [u8; 38] =
    "mkdir.ENH-012 multipos FAIL path_len\n\0"
  pub let fail_multipos_path_len_len : u64 = 37

  pub let fail_multipos_shared_txn_msg : [u8; 40] =
    "mkdir.ENH-012 multipos FAIL shared_txn\n\0"
  pub let fail_multipos_shared_txn_len : u64 = 39

  // ============================================================================
  // Bootstrap argv — `mkdir a b c`. Three single-letter positionals,
  // no flags. Each positional is its own mkdir_one("a"/"b"/"c") call
  // inside mkdir_run's shared-TXN loop.
  // ============================================================================

  pub let argv_mp_a         : [u8; 2] = "a\0"
  pub let argv_mp_b         : [u8; 2] = "b\0"
  pub let argv_mp_c         : [u8; 2] = "c\0"
  pub let mut argv_mp_ptrs  : [u64; 3] = uninit @align(8)
  pub let argv_mp_argc      : u64 = 3

  // ============================================================================
  // run_test_enh_multi_positional() -> u64
  //
  // Signature: () -> u64 !{mem, sysreg} @{cap}
  //   rax = 0 on PASS, 1 on FAIL.
  //
  // CreatedDirRecord layout reminder (4 u64 fields/record, 32 bytes):
  //   +0 path_ptr, +8 path_len, +16 parent_txn_id, +24 owner_slot_ref.
  // Record i's byte offset from created_dir_records' base is i*32, so:
  //   record 0: path_len @+8,  parent_txn_id @+16
  //   record 1: path_len @+40, parent_txn_id @+48
  //   record 2: path_len @+72, parent_txn_id @+80
  //
  // Assertions:
  //   exit_code                    == 0
  //   newly_created_count          == 3
  //   created_dir_records_count    == 3
  //   rmdir_undo_records_count     == 3
  //   record[0..2].path_len        == 1 (each of "a"/"b"/"c" is one byte
  //                                       — mkdir.ENH-005's non-`-p`
  //                                       path_len fix, exercised three
  //                                       times over three DIFFERENT
  //                                       positionals rather than one)
  //   record[0].parent_txn_id     == record[1].parent_txn_id
  //                                == record[2].parent_txn_id
  //                                       (mkdir.ENH-006: ONE shared TXN
  //                                       across every positional, not
  //                                       one re-opened per positional)
  //
  // Register plan (all caller-save; no push/pop parity):
  //   rax/rcx/rdx = record field loads compared against each other
  //   r11 = LEA scratch
  // ============================================================================
  pub let run_test_enh_multi_positional : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "mkdir.ENH-012 run_test_enh_multi_positional — regression test for the mkdir.ENH-006 double-commit + record-clobber bugs. Resets MkdirState + ParsedArgs, seeds bootstrap argv `a b c` (three single-letter positionals, no flags), calls parse_argv + parse_flags_from_argv + mkdir_run identically to src/mkdir.pdx _start Steps 3..7. Asserts exit_code == 0, newly_created_count == 3, created_dir_records_count == 3, rmdir_undo_records_count == 3 (the four invocation-wide counters mkdir_run now owns post-ENH-006), then walks created_dir_records by fixed byte offset (record i at i*32; path_len @ +8, parent_txn_id @ +16 within each 32-byte record) to assert record[0..2].path_len == 1 (mkdir.ENH-005's non-`-p` path_len fix, exercised across three distinct positionals rather than one call) and record[0].parent_txn_id == record[1].parent_txn_id == record[2].parent_txn_id (mkdir.ENH-006: one shared TXN spans every positional, not one opened+committed per positional). Any assert-fail emits its per-check FAIL diagnostic then returns 1; all-pass emits ok_multipos_msg then returns 0. paideia-as conformance: no `test` mnemonic; r11 LEA scratch only; every cmp reg,imm well under 0x7FFFFFFF (max seen: 80, a byte offset); no push/pop parity — straight-line driver with only leaf-return calls. Labels prefixed tep_ (test-enh-positional) avoid every paideia-as reserved keyword. Cross-module calls by unqualified linker name (mkdir_state_reset / reset / parse_argv / parse_flags_from_argv / mkdir_run / emit_stderr).",
      block: {
        // ---- Reset. ----
        call mkdir_state_reset;
        call reset;

        // ---- Build argv_mp_ptrs = [&a, &b, &c]. ----
        lea rcx, [rip + argv_mp_ptrs];
        lea r11, [rip + argv_mp_a];   mov [rcx + 0],  r11;
        lea r11, [rip + argv_mp_b];   mov [rcx + 8],  r11;
        lea r11, [rip + argv_mp_c];   mov [rcx + 16], r11;

        // ---- parse_argv(argv_mp_ptrs, 3). ----
        lea rdi, [rip + argv_mp_ptrs];
        mov rsi, 3;                               // argv_mp_argc
        call parse_argv;
        cmp rax, 0;
        jne tep_fail_rc;

        // ---- parse_flags_from_argv. ----
        call parse_flags_from_argv;

        // ---- mkdir_run. ----
        call mkdir_run;

        // ---- Assertions. ----

        // exit_code == 0.
        lea r11, [rip + exit_code];
        mov rax, [r11];
        cmp rax, 0;
        jne tep_fail_rc;

        // newly_created_count == 3.
        lea r11, [rip + newly_created_count];
        mov rax, [r11];
        cmp rax, 3;
        jne tep_fail_newly_created;

        // created_dir_records_count == 3.
        lea r11, [rip + created_dir_records_count];
        mov rax, [r11];
        cmp rax, 3;
        jne tep_fail_cdr_count;

        // rmdir_undo_records_count == 3.
        lea r11, [rip + rmdir_undo_records_count];
        mov rax, [r11];
        cmp rax, 3;
        jne tep_fail_rur_count;

        // record[0].path_len == 1.
        lea r11, [rip + created_dir_records];
        mov rax, [r11 + 8];
        cmp rax, 1;
        jne tep_fail_path_len;

        // record[1].path_len == 1.
        mov rax, [r11 + 40];
        cmp rax, 1;
        jne tep_fail_path_len;

        // record[2].path_len == 1.
        mov rax, [r11 + 72];
        cmp rax, 1;
        jne tep_fail_path_len;

        // record[0].parent_txn_id == record[1].parent_txn_id.
        mov rax, [r11 + 16];
        mov rcx, [r11 + 48];
        cmp rax, rcx;
        jne tep_fail_shared_txn;

        // record[0].parent_txn_id == record[2].parent_txn_id.
        mov rdx, [r11 + 80];
        cmp rax, rdx;
        jne tep_fail_shared_txn;

        // ---- All-pass: emit OK witness + return 0. ----
        lea rdi, [rip + ok_multipos_msg];
        mov rsi, 34;                              // ok_multipos_len
        call emit_stderr;
        xor rax, rax;
        ret;

      tep_fail_rc:
        lea rdi, [rip + fail_multipos_rc_msg];
        mov rsi, 31;                              // fail_multipos_rc_len
        call emit_stderr;
        mov rax, 1;
        ret;

      tep_fail_newly_created:
        lea rdi, [rip + fail_multipos_newly_created_msg];
        mov rsi, 48;                              // fail_multipos_newly_created_len
        call emit_stderr;
        mov rax, 1;
        ret;

      tep_fail_cdr_count:
        lea rdi, [rip + fail_multipos_cdr_count_msg];
        mov rsi, 38;                              // fail_multipos_cdr_count_len
        call emit_stderr;
        mov rax, 1;
        ret;

      tep_fail_rur_count:
        lea rdi, [rip + fail_multipos_rur_count_msg];
        mov rsi, 38;                              // fail_multipos_rur_count_len
        call emit_stderr;
        mov rax, 1;
        ret;

      tep_fail_path_len:
        lea rdi, [rip + fail_multipos_path_len_msg];
        mov rsi, 37;                              // fail_multipos_path_len_len
        call emit_stderr;
        mov rax, 1;
        ret;

      tep_fail_shared_txn:
        lea rdi, [rip + fail_multipos_shared_txn_msg];
        mov rsi, 39;                              // fail_multipos_shared_txn_len
        call emit_stderr;
        mov rax, 1;
        ret;
      }
    }
}
