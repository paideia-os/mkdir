// tests/test_m4_004_cap_tail.pdx — mkdir.M4-004
// MkdirTestM4004 module: cap-tail correctness — the owner_slot_ref
// field of every CreatedDirRecord matches SLOT_USER (== 2 at v1.0).
//
// Per design/tooling/r49-r50-plan.md §5.9 (paideia-os) M4 line:
//   "cap-tail correctness (owner matches invoker in every created
//    inode)"
//
// This test freezes the M2-003 + M3-001 owner-stamp seam: the cap-tail
// write happens per-level under mkdir_one Step 6d, and each successful
// stamp is followed by Step 6e's CreatedDirRecord staging with
// owner_slot_ref = SLOT_USER. `ls --long <dir>` renders the owner by
// resolving owner_slot_ref through libpdx-cap M3-001's decode helper;
// a wrong or missing owner_slot_ref would render as an anonymous owner
// — a D3/D4 violation.
//
// ============================================================================
// What M4-004 asserts vs what M4-001..M4-003 assert
// ============================================================================
//
// M4-001..M4-003 all assert on COUNTS (`comp_count`,
// `newly_created_count`, `created_dir_records_count`,
// `rmdir_undo_records_count`). M4-004 is the first driver that reads
// the CDR array's BODY — specifically the `owner_slot_ref` field at
// byte offset +24 of each 32-byte record. This is the "cap-tail
// correctness" the plan doc's M4-004 line requires.
//
// The M3-001 CDR record layout (see MkdirState comment block):
//   [+0]  path_ptr        — u8* (base of the full path string)
//   [+8]  path_len        — u64 (byte count from path_ptr)
//   [+16] parent_txn_id   — u64 (shared across all records in one TXN)
//   [+24] owner_slot_ref  — u64 (== SLOT_USER = 2 at v1.0)
//
// Records are laid out row-major in the `created_dir_records` array:
//   record_idx * CDR_FIELDS_PER_RECORD (== 4) * 8 bytes
// So the owner_slot_ref of record i lives at byte offset
// `i * 32 + 24` from the array base — indexed here as
// `[base + i*8*4 + 24]` == `[base + rcx*8 + 24]` where rcx == i * 4.
//
// M4-004 seeds the CDR array through the natural `mkdir -p a/b/c`
// bootstrap (both the CDR staging at Step 6e and the owner_slot_ref
// write at that step run at HEAD via placeholder cap invocations) and
// then walks the array asserting each owner_slot_ref == 2.
//
// paideia-as conformance identical to earlier M4 drivers. Labels
// prefixed t4c_ (test-m4-004-cap-tail) — avoids every reserved
// keyword. This driver DOES loop over the record array (unlike the
// earlier drivers), so it manages a walk index in a caller-save reg
// (rcx) and re-loads .bss slots per iteration rather than caching in
// callee-save (no push/pop parity to preserve).
//
// Upstream: design/tooling/r49-r50-plan.md §5.9 (paideia-os).

module MkdirTestM4004 = structure {

  // ============================================================================
  // Witness strings.
  // ============================================================================

  pub let ok_owner_msg    : [u8; 24] = "mkdir.M4-004 owner OK\n\0\0"
  pub let ok_owner_len    : u64 = 22

  pub let fail_rc_msg              : [u8; 32] = "mkdir.M4-004 FAIL rc nonzero\n\0\0\0"
  pub let fail_rc_len              : u64 = 29

  pub let fail_cdr_count_msg       : [u8; 32] = "mkdir.M4-004 FAIL cdr_count\n\0\0\0\0"
  pub let fail_cdr_count_len       : u64 = 28

  pub let fail_owner_slot_msg      : [u8; 40] = "mkdir.M4-004 FAIL owner_slot_ref[i]\n\0\0\0\0"
  pub let fail_owner_slot_len      : u64 = 36

  // ============================================================================
  // Bootstrap argv — `mkdir -p a/b/c` (three-level; three CDRs staged).
  // ============================================================================

  pub let argv_owner_p        : [u8; 3]  = "-p\0"
  pub let argv_owner_abc      : [u8; 6]  = "a/b/c\0"
  pub let mut argv_owner_ptrs : [u64; 2] = uninit @align(8)
  pub let argv_owner_argc     : u64 = 2

  // ============================================================================
  // run_test_m4_004_owner() -> u64
  //
  // Signature: () -> u64 !{mem, sysreg} @{cap}
  //   rax = 0 on PASS, 1 on FAIL.
  //
  // Sequence:
  //   1. mkdir_state_reset + reset.
  //   2. Seed bootstrap argv `-p a/b/c`.
  //   3. parse_argv + parse_flags_from_argv + mkdir_run.
  //   4. Assert exit_code == 0 (baseline — the walk itself must have
  //      completed for the CDR body assertion to be meaningful).
  //   5. Assert created_dir_records_count == 3 (all three CDRs staged
  //      + frozen at Step 7).
  //   6. Walk record indices i = 0..3 asserting
  //      created_dir_records[i * 4 + 3] == 2 (SLOT_USER).
  //      Byte-offset arithmetic: i * 4 words == i * 32 bytes; the +3
  //      word offset == +24 bytes reaches the owner_slot_ref field.
  //      Formed as `[base + rcx*8 + 24]` where rcx == i * 4.
  //   7. All-pass → ok_owner_msg + return 0. Any failure → per-check
  //      diagnostic + return 1.
  //
  // Register plan (all caller-save; no push/pop):
  //   rax = state loads / call return / field load
  //   rcx = walk-index scratch (== i * 4 during the CDR walk)
  //   rdx = loop counter i (0..3) — kept live across the .bss read
  //         because we need i to increment; the field-load uses rax
  //         which does not shadow rdx.
  //   rdi/rsi = call args (also SysV pushed at call-site)
  //   r11 = LEA scratch
  //
  // paideia-as conformance identical to earlier M4 drivers. Labels
  // prefixed t4c_ (test-m4-004-cap-tail).
  // ============================================================================
  pub let run_test_m4_004_owner : () -> u64 !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "mkdir.M4-004 run_test_m4_004_owner — cap-tail correctness. Resets MkdirState + ParsedArgs, seeds bootstrap `-p a/b/c`, invokes parse_argv + parse_flags_from_argv + mkdir_run. Asserts baseline: exit_code == 0 AND created_dir_records_count == 3 (walker completed + Step 7 CDR-count freeze ran). Then walks record indices i = 0..3 asserting each created_dir_records[i * 4 + 3] == 2 (SLOT_USER, the owner_slot_ref field at byte offset +24 of each 32-byte record). The `i * 4 + 3` word offset resolves to `i * 32 + 24` bytes — indexed as `[base + rcx*8 + 24]` where rcx = i * 4 (scaled *8 by the SIB then +24 disp). The loop counter i lives in rdx (caller-save; survives the LEA + mov but has no external clobber to worry about — no calls in the loop body). paideia-as conformance: r11 LEA scratch only; every cmp reg,imm ≤ 3 (max: loop bound `i < 3` and owner_slot_ref == 2); no test mnemonic (every zero-check cmp reg, 0); byte loads N/A (u64 field reads only); no push/pop parity — driver is straight-line with leaf-return calls at the top and a pure-in-.bss walk in the middle. Labels prefixed t4c_ avoid every paideia-as reserved keyword. Cross-module calls by unqualified linker name (mkdir_state_reset / reset / parse_argv / parse_flags_from_argv / mkdir_run / emit_stderr).",
      block: {
        // ==========================================================
        // Setup + baseline.
        // ==========================================================

        call mkdir_state_reset;
        call reset;

        // Build bootstrap argv `-p a/b/c`.
        lea rcx, [rip + argv_owner_ptrs];
        lea r11, [rip + argv_owner_p];      mov [rcx + 0], r11;
        lea r11, [rip + argv_owner_abc];    mov [rcx + 8], r11;

        // parse_argv(argv, 2).
        lea rdi, [rip + argv_owner_ptrs];
        mov rsi, 2;                               // argv_owner_argc
        call parse_argv;
        cmp rax, 0;
        jne t4c_fail_rc;

        // parse_flags_from_argv.
        call parse_flags_from_argv;

        // mkdir_run.
        call mkdir_run;

        // exit_code == 0.
        lea r11, [rip + exit_code];
        mov rax, [r11];
        cmp rax, 0;
        jne t4c_fail_rc;

        // created_dir_records_count == 3.
        lea r11, [rip + created_dir_records_count];
        mov rax, [r11];
        cmp rax, 3;
        jne t4c_fail_cdr_count;

        // ==========================================================
        // Walk record indices i = 0..3 asserting owner_slot_ref == 2.
        //
        // Loop shape:
        //   rdx = i (0..3)
        //   rcx = i * 4 (word index scaled for [base + rcx*8 + 24])
        //   rax = created_dir_records[rcx*8 + 24] load
        //
        // No calls in the loop body → no callee-save state to preserve.
        // ==========================================================
        xor rdx, rdx;                             // i = 0

      t4c_walk_head:
        cmp rdx, 3;
        jge t4c_walk_done;

        // rcx = i * 4 (word offset within the record for the
        // owner_slot_ref field's +24 byte disp to reach the right
        // record). Compute via shl 2.
        mov rcx, rdx;
        shl rcx, 2;                               // rcx = i * 4

        // rax = created_dir_records[i * 32 + 24].
        lea r11, [rip + created_dir_records];
        mov rax, [r11 + rcx*8 + 24];              // owner_slot_ref

        // Assert == 2 (SLOT_USER).
        cmp rax, 2;
        jne t4c_fail_owner_slot;

        // i += 1.
        add rdx, 1;
        jmp t4c_walk_head;

      t4c_walk_done:
        // All three records had owner_slot_ref == 2.
        lea rdi, [rip + ok_owner_msg];
        mov rsi, 22;                              // ok_owner_len
        call emit_stderr;
        xor rax, rax;
        ret

      // ---- Failures ----

      t4c_fail_rc:
        lea rdi, [rip + fail_rc_msg];
        mov rsi, 29;                              // fail_rc_len
        call emit_stderr;
        mov rax, 1;
        ret

      t4c_fail_cdr_count:
        lea rdi, [rip + fail_cdr_count_msg];
        mov rsi, 28;                              // fail_cdr_count_len
        call emit_stderr;
        mov rax, 1;
        ret

      t4c_fail_owner_slot:
        lea rdi, [rip + fail_owner_slot_msg];
        mov rsi, 36;                              // fail_owner_slot_len
        call emit_stderr;
        mov rax, 1;
        ret
      }
    }
}
