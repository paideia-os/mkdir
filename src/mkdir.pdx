// src/mkdir.pdx -- mkdir v1.1-A (real body extraction)
//
// v1.1-A retires the M1..M5 STUB scaffold and wires the real
// `sys_mkdir` syscall (sysno 79, per paideia-os
// design/user/syscall-table.md row 79) as the tool's create primitive.
//
// -----------------------------------------------------------------------------
// v1.1-A behavioural contract
// -----------------------------------------------------------------------------
//
//   mkdir <PATH> [<PATH>...]
//
// - argv is read directly from the frozen execve ABI: rdi = argc,
//   rsi = argv (u64*), where argv[0] is the program name. See
//   paideia-os design/user/execve-abi.md.
// - Each positional PATH argv[1..argc] is passed to sys_mkdir with
//   mode 0755 (0x1ED) and a path_len_hint of 255 -- the walker-cap
//   convention documented in paideia-os design/user/syscall-table.md
//   §"Walker length hint semantics" (the kernel copies up to
//   min(hint, 255) bytes from user VA until it sees NUL; callers pass
//   255 or any bound larger than the actual path).
// - No -p (parents), no -m (custom mode): v1.1-A is intentionally the
//   minimum viable body. Multi-level paths that need parent creation
//   are the caller's obligation until v1.2-A relands the -p walker on
//   top of the real substrate.
// - Exit contract: 0 on all-success; on the first sys_mkdir that
//   returns non-zero the tool exits with that value (a negative errno
//   per the paideia-os -errno sentinel convention, which sys_exit
//   accepts verbatim as its status word). No further positionals are
//   attempted after the first failure.
// - argc < 2 (no positional) is a hard error: emits `mkdir: missing
//   operand\n` and exits 2 (retained for continuity with the M5-era
//   MK_MISSING_PATH code).
//
// -----------------------------------------------------------------------------
// What v1.1-A retires from M1..M5
// -----------------------------------------------------------------------------
//
// The v1.0.0 tag shipped a shape-only scaffold that dispatched every
// step through placeholder `sys_cap_invoke` ops on four cap slots
// (KIND_PDXFS_TXN / KIND_PDXFS_FILE / KIND_USER / KIND_IPC_ENDPOINT).
// No directory was ever created on disk -- PXT_OP_CREATE stubbed to
// PXT_STUB_OK, the "commit" was a state-transition on a placeholder
// TXN, and argv was a static bootstrap array (`-p -v --dry-run
// a/b/c`) so the tool could not read what a user typed. Every one of
// those seams is retired at v1.1-A:
//
//   - `_init_caps` sidecar removed entirely -- the tool takes no caps
//     at exec, since sys_mkdir is a plain @{fs} syscall and does not
//     go through the cap subsystem.
//   - `parse_flags_from_argv`, `mkdir_split_path`, `mkdir_one`,
//     `mkdir_run` deleted -- v1.1-A is one straight-line loop in
//     `_start` with no per-path helper.
//   - `mkdir_state.pdx` deleted -- v1.1-A carries no state across
//     iterations, so MkdirState's `.bss` singletons, per-component
//     bookkeeping arrays, and CreatedDirRecord[] / RmdirUndoRecord[]
//     staging are all unnecessary.
//   - libpdx-argv dependency dropped -- argv is read directly from
//     rdi/rsi per the execve ABI, matching the pattern
//     paideia-os/src/user/mkdir.pdx (the in-kernel /bin/mkdir) uses.
//   - libpdx-cap, libpdx-audit, libpdx-semantic-pipe dependencies
//     dropped (grep-verified never linked in the M1..M5 scaffold
//     either; enhancement-plan §3.7 already listed these three as
//     stale pins).
//   - `caps.decl` narrowed to zero required caps.
//   - `-p`, `-v`, `--dry-run`, `--schema`, `--version` flags removed:
//     v1.1-A recognises no flags. `--help` remains shell-dispatched to
//     `doc mkdir` (mkdir never saw the flag under M5 either).
//   - CreatedDirRecord@0.1 and RmdirUndoRecord@0.1 schema emit removed
//     -- with no state to stage and no consumer in the ecosystem, the
//     record shape returns as a live emit when a follow-up wave lands
//     the semantic-pipe consumer.
//   - Audit-journal emit removed -- audit is D3 obligation but the
//     hand-rolled sys_cap_invoke shape was never a real libpdx-audit
//     call. A follow-up wave rebuilds it on the real library.
//
// -----------------------------------------------------------------------------
// SC+ IDs used
// -----------------------------------------------------------------------------
//
// Inlined directly at call sites -- no syscall_shim link dependency,
// mirroring paideia-os/src/user/mkdir.pdx and its sibling /bin
// tools (true.pdx / cat.pdx / rm.pdx / mv.pdx / cp.pdx).
//
//   12 = sys_debug_puts(buf, count) -- stderr diagnostic emit
//   60 = sys_exit(status)           -- never returns
//   79 = sys_mkdir(path_va, path_len_hint, mode) -- R56.M3-004 (#1793)
//        kernel body at src/kernel/core/syscall/sys_mkdir.pdx. rax = 0
//        on success, negative errno on failure (see paideia-os
//        design/user/syscall-table.md and sys_mkdir.pdx §Failure
//        taxonomy: -EFAULT / -ENOENT / -ENOTDIR / -EIO / etc.).
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// - rbx = argc (SysV callee-save; syscall preserves it -- amd64
//   fast-syscall only clobbers rcx/r11).
// - r12 = argv base pointer (SysV callee-save).
// - r13 = current positional index (starts at 1 to skip argv[0]).
// - r14 = saved -errno across the failure-diagnostic sys_debug_puts
//   call (so we can pass the original -errno through to sys_exit).
// - rdi/rsi/rdx/rax carry syscall args at each site.
// - No prologue push: entry rsp % 16 == 0 per the PVH loader
//   contract, and every terminal path ends in sys_exit (never
//   returns), so there is no callee-save state to preserve for a
//   caller that does not exist.
// - @no_frame attribute reflects the never-return shape.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline (paideia-as feedback_pdx_encoder_pitfalls)
// -----------------------------------------------------------------------------
//
// - No `add reg, [mem]` / `sub reg, [mem]` anywhere.
// - All `cmp reg, imm` immediates fit in imm16 (max seen: 0x1ED = 493).
// - No `test` mnemonic; zero-checks use `cmp rax, 0`.
// - r11 reserved as LEA scratch (not used here -- straight-line body
//   has no LEA-into-scratch pattern).
// - Reserved-label discipline: every label is prefixed `mkdir_` to
//   dodge paideia-as reserved keywords (`loop`, `if`, `let`, `fn`,
//   `pub`, `mut`, `struct`, `structure`, `unsafe`, `block`).

module Mkdir = structure {

  // Diagnostic strings -- NUL-terminated for future strlen consumers;
  // wire length excludes the trailing NUL. ASCII "--" in place of an
  // em-dash keeps every line 7-bit ASCII (mirrors paideia-os user
  // tools' fingerprint-string convention).

  pub let err_no_operand_msg : [u8; 24] = "mkdir: missing operand\n\0"
  pub let err_no_operand_len : u64 = 23

  pub let err_mkdir_fail_msg : [u8; 20] = "mkdir: create failed\n\0"
  pub let err_mkdir_fail_len : u64 = 19

  // -----------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Signature per execve ABI (paideia-os design/user/execve-abi.md):
  //   rdi = argc (u64)
  //   rsi = argv (u64*) -- argv[0] is program name
  //
  // Effects/caps:
  //   mem     -- reads err_* rodata; dereferences argv[i] pointers.
  //   sysreg  -- every SYSCALL clobbers rcx (RIP) / r11 (rflags).
  //   fs      -- sys_mkdir surface.
  //   sched   -- sys_exit terminates the task.
  //
  // @no_frame because every terminal path ends in sys_exit (never
  // returns), matching every /bin coreutil in the paideia-os user tree.
  // -----------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "mkdir v1.1-A _start: real sys_mkdir extraction from the M1..M5 STUB. Reads argc (rdi) and argv (rsi) per the frozen execve ABI (paideia-os design/user/execve-abi.md, matching src/user/mkdir.pdx and every /bin sibling). argc < 2 -> emit `mkdir: missing operand\\n` via sys_debug_puts (SC+ ID 12), sys_exit(2). Otherwise walk argv[1..argc]: for each positional, load argv[i] into rdi and call sys_mkdir (SC+ ID 79, R56.M3-004 kernel body at src/kernel/core/syscall/sys_mkdir.pdx) with rsi = 255 (walker-cap hint per design/user/syscall-table.md §Walker length hint semantics) and rdx = 0x1ED (mode 0755, matching rootfs_seed.pdx's /home mkdir at src/user/rootfs_seed.pdx L213). rax == 0 -> advance to next positional. rax != 0 -> failure branch: preserve -errno in r14 across a diagnostic sys_debug_puts of `mkdir: create failed\\n`, then sys_exit(r14) -- the -errno is passed through verbatim to sys_exit's status word per the v1.1-A contract (`0 on success, -errno on first failure`). Loop-index invariant: r13 starts at 1 (skip argv[0] = program name) and increments by 1 on each success; loop exits when r13 == rbx (argc). All-success path: sys_exit(0). Register plan: rbx = argc, r12 = argv base, r13 = i, r14 = saved -errno (all SysV callee-save; amd64 fast-syscall preserves them, so no push/pop needed across the sys_mkdir loop iterations). rdi/rsi/rdx/rax are the SysV syscall arg registers. @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract. Encoder-gap discipline: no `add reg, [mem]` / `sub reg, [mem]` anywhere; `mov rdi, [r12 + r13*8]` uses base+index*scale addressing which the encoder supports directly (mirrors src/user/mkdir.pdx's `mov rbx, [rsi + 8]` for a single-index load). Every cmp uses an immediate <= 0x1ED (mode) or a register (argc bound), all fitting imm16 with no sign-extension hazard. No `test` mnemonic. Labels prefixed `mkdir_` to dodge paideia-as reserved keywords (`loop`, `if`, `let`, `fn`, `pub`, `mut`, `struct`, `structure`, `unsafe`, `block`).",
      block: {
        // ==========================================================
        // Phase 0 -- argc guard: at least one positional required.
        // ==========================================================
        cmp rdi, 2;
        jl  mkdir_missing_operand;

        // Stash argc + argv base into callee-save registers so the
        // sys_mkdir syscalls in the loop below do not have to worry
        // about SysV arg-register clobbering.
        mov rbx, rdi;                          // rbx = argc
        mov r12, rsi;                          // r12 = argv base
        mov r13, 1;                            // r13 = i (skip argv[0])

        // ==========================================================
        // Phase 1 -- per-positional sys_mkdir loop.
        // ==========================================================

      mkdir_loop_head:
        cmp r13, rbx;
        jge mkdir_all_ok;

        // rdi = argv[i]. Own-aspace pointer per execve ABI --
        // sys_mkdir's user_read_str_via_walk (kernel-side, in
        // src/kernel/core/syscall/sys_mkdir.pdx) does the KPTI-safe
        // walk from this user VA up to path_len_hint bytes.
        mov rdi, [r12 + r13*8];

        // sys_mkdir(path=rdi, path_len_hint=255, mode=0x1ED)
        mov rsi, 255;                          // walker CAP hint
        mov rdx, 0x1ED;                        // mode 0755
        mov rax, 79;                           // SC+ ID 79 = sys_mkdir
        syscall;

        cmp rax, 0;
        jne mkdir_fail;

        // Success on this positional; advance i and loop.
        add r13, 1;
        jmp mkdir_loop_head;

        // ==========================================================
        // Phase 2 -- all-success terminator.
        // ==========================================================

      mkdir_all_ok:
        xor rdi, rdi;                          // exit status = 0
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt;

        // ==========================================================
        // Phase 3 -- first-failure terminator: preserve -errno and
        // pass it through to sys_exit.
        // ==========================================================

      mkdir_fail:
        // Save -errno into r14 (callee-save; survives the diagnostic
        // sys_debug_puts syscall below).
        mov r14, rax;

        lea rdi, [rip + err_mkdir_fail_msg];
        mov rsi, 19;                           // err_mkdir_fail_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;

        // Exit with the negative errno the failing sys_mkdir returned
        // -- v1.1-A contract: `-errno on first failure`.
        mov rdi, r14;
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt;

        // ==========================================================
        // Phase 4 -- missing-operand terminator (argc < 2).
        // ==========================================================

      mkdir_missing_operand:
        lea rdi, [rip + err_no_operand_msg];
        mov rsi, 23;                           // err_no_operand_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;

        mov rdi, 2;                            // exit status = MK_MISSING_PATH
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt
      }
    } @no_frame
}
