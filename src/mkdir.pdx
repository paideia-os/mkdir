// src/mkdir.pdx -- mkdir v1.2.0 (semantic-pipe emission wire)
//
// v1.2.0 (paideia-os/mkdir#30) extends v1.1-B with a MkdirRecord@0.1
// emit via `sys_semantic_send` (SC+ ID 115, R107-M0-001 #2350; kernel
// body at src/kernel/core/syscall/handlers/sys_semantic_send.pdx)
// after every successful `sys_mkdir`. Best-effort: the return value
// (0 / -EFAULT / -EINVAL) is discarded — the directory is already on
// disk and a ring-refusal is a marshalling bug in this file (32-byte
// record within the [1, 240] cap, static rip-relative record_ptr never
// fails user_ptr_ok) rather than a per-run condition the caller can
// act on. The record's field layout is documented in caps.decl's
// `declares_output_schemas:` block: 32 bytes = { path_ptr u64,
// path_len u64, mode u64, status u64 }, schema tag 0x4D6B646972526501
// ("MkdirRe\x01"). See below §"v1.2.0 record marshalling" for the
// register plan and the record_buf .bss layout.
//
// v1.1-B extends v1.1-A with explicit userspace resolution of relative
// paths against the caller's kernel cwd via `sys_getcwd` (SC+ ID 86,
// R86.M1-003 #1956 kernel body at src/kernel/core/syscall/sys_getcwd.pdx).
//
// -----------------------------------------------------------------------------
// mkdir.ENH-010 rationale (paideia-os/mkdir issue #25)
// -----------------------------------------------------------------------------
//
// R86 landed real kernel cwd (`sys_chdir` / `sys_getcwd`) AFTER mkdir
// shipped v1.0.0. Under v1.1-A mkdir passed argv[i] raw to `sys_mkdir`
// and relied on the kernel-side `path_resolve(..., cwd=TASK_OFF_CWD)`
// (sys_mkdir.pdx §(6), R86.M1-005 #1958) to anchor a relative path
// against the task's TCB cwd. That was correct *once* the kernel was
// updated, but it left the tool blind to what it was actually creating:
// the string handed to `sys_mkdir` was the same "foo" the user typed,
// while the on-disk path was `getcwd() + "/foo"`. Any smoke witness
// asserting the created path had to consult the kernel's cwd for the
// prefix -- a coupling nothing else in the coreutil surface has.
//
// v1.1-B moves the join into userspace: for a relative path we call
// `sys_getcwd` first, concatenate `cwd + '/' + path` into a bounded
// scratch, and pass the resolved absolute path to `sys_mkdir`. Two
// benefits fall out:
//
//   (a) The string handed to `sys_mkdir` is the absolute path that
//       lands on disk. Smoke witnesses assert against argv-visible
//       state instead of the kernel's TCB cwd.
//   (b) A future backend adapter that does NOT honour TASK_OFF_CWD
//       (a future networked or overlay FS, an out-of-band probe tool)
//       still gets the correct target, because the resolution has
//       happened before the syscall boundary.
//
// Absolute paths (leading '/') are passed through unchanged -- the
// kernel-side walker anchors them against the mount root regardless of
// cwd, so any prefixing on our side would be actively wrong.
//
// -----------------------------------------------------------------------------
// v1.1-B behavioural contract
// -----------------------------------------------------------------------------
//
//   mkdir <PATH> [<PATH>...]
//
// - argv is read directly from the frozen execve ABI: rdi = argc,
//   rsi = argv (u64*), where argv[0] is the program name. See
//   paideia-os design/user/execve-abi.md.
// - Each positional PATH argv[1..argc] is classified by its first byte:
//     '/'  -> absolute; passed to `sys_mkdir` as-is.
//     '.'  followed by NUL (exactly ".") -> nonsensical (mkdir the cwd
//          itself creates nothing); emits `mkdir: refusing to mkdir "."\n`
//          on the debug channel and exits 1.
//     anything else -> relative; resolved against `sys_getcwd` and passed
//          to `sys_mkdir` as an absolute path. "./foo", "..", ".foo",
//          and multi-component paths like "a/b" all flow through this
//          arm; the kernel's path_resolve normalises "." components
//          and refuses ".." per its own semantics.
// - `sys_mkdir` is called with mode 0755 (0x1ED) and a path_len_hint of
//   255 -- the walker-cap convention documented in paideia-os
//   design/user/syscall-table.md §"Walker length hint semantics".
// - No -p (parents), no -m (custom mode): v1.1-B keeps v1.1-A's
//   minimum-viable body. Multi-level paths that need parent creation
//   are the caller's obligation until v1.2-A relands the -p walker.
// - Exit contract: 0 on all-success; on the first `sys_mkdir` that
//   returns non-zero the tool exits with that value (a negative errno
//   per the paideia-os -errno sentinel convention, accepted verbatim
//   by `sys_exit`). No further positionals are attempted after the
//   first failure. Additional v1.1-B exits:
//     1 = MK_DOT_CWD_NONSENSICAL (`mkdir .`)
//     2 = MK_MISSING_PATH        (argc < 2, retained from v1.1-A)
//     4 = MK_PATH_TOO_LONG       (resolved path exceeds SYS_MKDIR_PATH_MAX-1)
//   plus the negative -errno passthrough from `sys_getcwd` when its
//   own -EFAULT / -ENOENT / -ERANGE fires (not reachable in practice
//   at R86; a task's cwd is always valid and a full 256-byte buffer
//   never triggers -ERANGE, but the syscall's own contract allows all
//   three and we pass whatever it returns).
//
// -----------------------------------------------------------------------------
// SC+ IDs used (inlined; no syscall_shim link)
// -----------------------------------------------------------------------------
//
//   12 = sys_debug_puts(buf, count)    -- stderr diagnostic emit
//   60 = sys_exit(status)              -- never returns
//   79 = sys_mkdir(path_va, path_len_hint, mode) -- R56.M3-004 (#1793)
//   86 = sys_getcwd(buf_va, buf_len)   -- R86.M1-003 (#1956); returns
//        bytes written INCLUDING trailing NUL (POSIX getcwd(3)
//        convention: N-1 is the string's strlen) or negative errno.
//        Kernel body at src/kernel/core/syscall/sys_getcwd.pdx.
//  115 = sys_semantic_send(schema, record_ptr, record_len) -- R107-M0-001
//        (paideia-os #2350); ring-emission substrate for the
//        libpdx-semantic-pipe producer path. Return 0 on ring commit,
//        -EFAULT / -EINVAL on marshalling failure. mkdir at v1.2.0
//        (#30) treats the return as best-effort and discards it.
//        Kernel body at src/kernel/core/syscall/handlers/
//        sys_semantic_send.pdx.
//
// (Historical note: paideia-os/mkdir issue #25 describes the syscall
// as "sysno 84". That is a typo -- 84 is `mountinfo` per
// design/user/syscall-table.md row 84. `getcwd` is row 86 and every
// consumer in-tree -- syscall_shim.pdx L184, dispatch.pdx's
// pwd_builtin / cd_builtin -- calls `mov rax, 86`.)
//
// -----------------------------------------------------------------------------
// Buffers
// -----------------------------------------------------------------------------
//
// Two 256-byte .bss scratches:
//
//   _mkdir_cwd_scratch       -- destination for sys_getcwd. 256 bytes
//                               matches SYS_GETCWD_PATH_MAX in the
//                               kernel's own header (sys_getcwd.pdx),
//                               so any path the kernel can compose
//                               fits without a -ERANGE round-trip.
//   _mkdir_resolved_scratch  -- staging for the joined absolute path
//                               handed to sys_mkdir. 256 bytes matches
//                               SYS_MKDIR_PATH_MAX in the kernel's own
//                               header (sys_mkdir.pdx). We refuse any
//                               join whose total length exceeds 255
//                               (leaving room for the trailing NUL at
//                               index 255) with exit code 4.
//
// v1.2.0 adds one 32-byte .bss slot:
//
//   _mkdir_record_buf        -- record composition buffer for
//                               sys_semantic_send. 32 bytes = 4 x u64
//                               lanes (path_ptr, path_len, mode,
//                               status). Well within the kernel-side
//                               per-record cap of 240 (SSS_MAX_RECORD
//                               at sys_semantic_send.pdx). @align(8)
//                               so every u64 store is naturally
//                               aligned. Written to on each iteration
//                               (path_ptr / path_len) plus once at
//                               entry (mode / status).
//
// All scratches are single-flow: only `_start` writes them, and
// `_start` is one straight-line loop. There is no per-positional
// reset between iterations because every write path fully overwrites
// the bytes it consumes.
//
// -----------------------------------------------------------------------------
// Register discipline
// -----------------------------------------------------------------------------
//
// - rbx = argc (SysV callee-save; syscall preserves it).
// - r12 = argv base pointer (SysV callee-save).
// - r13 = current positional index (starts at 1 to skip argv[0]).
// - r14 = saved -errno across a diagnostic sys_debug_puts (so we can
//         pass the original -errno through to sys_exit).
// - r15 = raw argv[i] pointer, preserved across the `sys_getcwd`
//         syscall so the copy-user-bytes loop can read from it.
// - r8/r9/r10/r11/rcx/rdx/rax carry syscall args and per-loop scratch.
//   r11 is safe as loop scratch here because every use lies within a
//   syscall-free stretch (the copy loops run between syscalls; r11 is
//   never assumed live across a `syscall`).
// - rdi/rsi/rdx/rax carry syscall args at each site.
// - No prologue push: entry rsp % 16 == 0 per the PVH loader
//   contract, and every terminal path ends in sys_exit (never
//   returns), so there is no callee-save state to preserve.
// - @no_frame attribute reflects the never-return shape.
//
// -----------------------------------------------------------------------------
// Encoder-gap discipline (paideia-as feedback_pdx_encoder_pitfalls)
// -----------------------------------------------------------------------------
//
// - No `add reg, [mem]` / `sub reg, [mem]` anywhere.
// - No `test rN, rN`; every zero-check is `cmp reg, 0`.
// - No `and rN, imm64` on r8..r15.
// - No 2-op `imul r, imm`.
// - Every cmp immediate fits in imm16 (max seen: 0x1ED = 493).
// - Byte loads use `xor rax, rax; mov_b rax, [ptr]` per the #1248
//   mitigation pattern (mov_b does not zero-extend on its own --
//   same discipline sys_getcwd_body itself uses).
// - Reserved-label discipline: every label is prefixed `mkdir_` to
//   dodge paideia-as reserved keywords (`loop`, `if`, `let`, `fn`,
//   `pub`, `mut`, `struct`, `structure`, `unsafe`, `block`).

module Mkdir = structure {

  // Diagnostic strings -- NUL-terminated for future strlen consumers;
  // wire length excludes the trailing NUL. ASCII "--" in place of an
  // em-dash keeps every line 7-bit ASCII.

  pub let err_no_operand_msg      : [u8; 24] = "mkdir: missing operand\n\0"
  pub let err_no_operand_len      : u64 = 23

  pub let err_mkdir_fail_msg      : [u8; 22] = "mkdir: create failed\n\0"
  pub let err_mkdir_fail_len      : u64 = 21

  pub let err_dot_cwd_msg         : [u8; 28] = "mkdir: refusing to mkdir .\n\0"
  pub let err_dot_cwd_len         : u64 = 27

  pub let err_getcwd_fail_msg     : [u8; 24] = "mkdir: getcwd failed\n\0\0\0"
  pub let err_getcwd_fail_len     : u64 = 21

  pub let err_path_too_long_msg   : [u8; 32] = "mkdir: resolved path too long\n\0\0"
  pub let err_path_too_long_len   : u64 = 30

  // -----------------------------------------------------------------------
  // .bss scratches
  //
  // Both sized at 256 bytes to match the kernel's own SYS_GETCWD_PATH_MAX
  // and SYS_MKDIR_PATH_MAX limits verbatim -- see the header comment
  // above for the rationale.
  // -----------------------------------------------------------------------

  pub let mut _mkdir_cwd_scratch      : [u8; 256] = uninit @align(8)
  pub let mut _mkdir_resolved_scratch : [u8; 256] = uninit @align(8)

  // v1.2.0 (#30): 32-byte MkdirRecord@0.1 composition buffer.
  //
  //   [0..8]   path_ptr    (u64) -- filled per iteration before mkdir
  //   [8..16]  path_len    (u64) -- filled per iteration before mkdir
  //   [16..24] mode        (u64) -- pre-filled 0x1ED at _start entry
  //   [24..32] status      (u64) -- pre-filled 0 at _start entry
  //
  // The kernel's per-record cap (SSS_MAX_RECORD = 240 at
  // sys_semantic_send.pdx §Section 2) is 7.5x this size; the [1, 240]
  // length gate never trips on our 32-byte emit.
  pub let mut _mkdir_record_buf       : [u8; 32]  = uninit @align(8)

  // -----------------------------------------------------------------------
  // _start -- user program entry point. Never returns.
  //
  // Signature per execve ABI (paideia-os design/user/execve-abi.md):
  //   rdi = argc (u64)
  //   rsi = argv (u64*) -- argv[0] is program name
  //
  // Effects/caps:
  //   mem     -- reads err_* rodata; dereferences argv[i] pointers;
  //              writes _mkdir_cwd_scratch, _mkdir_resolved_scratch,
  //              _mkdir_record_buf (v1.2.0).
  //   sysreg  -- every SYSCALL clobbers rcx (RIP) / r11 (rflags).
  //   fs      -- sys_mkdir + sys_getcwd surface.
  //   sched   -- sys_exit terminates the task.
  //
  // v1.2.0 (#30) note: sys_semantic_send (SC+ ID 115) declares no
  // {cap} at either the shim (src/user/syscall_shim.pdx L661) or the
  // kernel body (sys_semantic_send.pdx L158) — it writes into the
  // fixed 16-slot global `_semantic_ring` and takes no cap slots.
  // The @{fs, sched} tail here therefore does NOT gain a new cap
  // when the emit lands; the @{ipc} declaration lives at caps.decl
  // for the shell-side reconciliation (exec-time), not in the
  // effect signature.
  //
  // @no_frame because every terminal path ends in sys_exit.
  // -----------------------------------------------------------------------
  pub let _start : () -> () !{mem, sysreg} @{fs, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg},
      capabilities: {fs, sched},
      justification: "mkdir v1.2.0 (#30) _start: extends v1.1-B (userspace cwd-relative resolution, #25) with MkdirRecord@0.1 emit via sys_semantic_send (SC+ ID 115, R107-M0-001 #2350) after every successful sys_mkdir. Reads argc (rdi) and argv (rsi) per the frozen execve ABI. argc < 2 -> emit `mkdir: missing operand\\n`, sys_exit(2). Pre-fills _mkdir_record_buf[16..24] = 0x1ED (mode) and _mkdir_record_buf[24..32] = 0 (status) once at entry via lea r11, [rip + _mkdir_record_buf] + mov [r11 + 16], rax pattern (rip-relative store proven at pdxsock main.pdx L1912). Walks argv[1..argc]: peeks argv[i]'s first byte. First byte '/' (0x2F) -> absolute arm mkdir_use_raw_absolute: inline bounded strlen(r15) into r9 (capped at 255, exits 4 MK_PATH_TOO_LONG on overflow), stashes r15 as path_ptr and r9 as path_len into _mkdir_record_buf via lea r11 + two mov, sets rdi = r15, jumps to shared sys_mkdir call site. First byte '.' (0x2E) AND second byte NUL -> exactly `.`; emits `mkdir: refusing to mkdir .\\n` and sys_exit(1) MK_DOT_CWD_NONSENSICAL (mkdir the cwd itself creates nothing; kernel would fail as -EEXIST regardless). Anything else -> relative arm mkdir_do_resolve: calls sys_getcwd (SC+ ID 86, R86.M1-003 kernel body sys_getcwd.pdx) into _mkdir_cwd_scratch with buf_len=256; rax < 0 -> emit `mkdir: getcwd failed\\n` and sys_exit(-errno) verbatim; rax > 0 -> cwd_len = rax - 1. Inline bounded strlen on argv[i] (capped at 255; overflow -> exit 4 MK_PATH_TOO_LONG). Separator = 0 if cwd is exactly `/`, else 1. total_len > 255 -> exit 4. Copies cwd + optional '/' + user into _mkdir_resolved_scratch, NUL-terminates, then stashes &_mkdir_resolved_scratch as path_ptr and r11 (final cursor, excludes NUL) as path_len into _mkdir_record_buf; falls through to sys_mkdir call site with rdi = &_mkdir_resolved_scratch. Common sys_mkdir call site: rsi = 255, rdx = 0x1ED, rax = 79, syscall. rax != 0 -> save -errno in r14, emit `mkdir: create failed\\n`, sys_exit(r14). rax == 0 -> emit MkdirRecord@0.1: mov rdi, 0x4D6B646972526501 (schema tag `MkdirRe\\x01`, movabs form, proven at sys_semantic_send.pdx L221 for errno constants); lea rsi, [rip + _mkdir_record_buf]; mov rdx, 32; mov rax, 115; syscall. Return value (0/-EFAULT/-EINVAL) discarded — best-effort (dir already on disk; 32-byte static rip-relative buf never fails user_ptr_ok and 32 sits inside [1, 240]). Advance i; loop. All-success: sys_exit(0). Register plan: rbx = argc, r12 = argv base, r13 = i, r14 = saved -errno (error paths only), r15 = raw argv[i] preserved across sys_getcwd (all five SysV callee-save; amd64 fast-syscall preserves them). r8/r9/r10/r11/rcx/rdx/rax carry per-loop scratch; r11 is safe as loop scratch here because every use lies within a syscall-free stretch (the copy loops and record-buf stores run between syscalls). Encoder-gap discipline: no `add reg, [mem]`/`sub reg, [mem]` anywhere; base+index loads go through mov_b/mov with SIB addressing (`mov_b rax, [rsi + rcx*1]`, `mov rdi, [r12 + r13*8]`). No `test rN, rN` (uses `cmp rN, 0`). No `and rN, imm64` on r8-r15. No 2-op `imul r, imm`. Every cmp immediate fits imm16 (max seen: 0x1ED). Byte loads use `xor rax, rax; mov_b rax, [ptr]` per the #1248 mitigation pattern. mov r64, imm64 (movabs) used for the schema-tag constant (0x4D6B646972526501). mov [rip + label + N], reg used for the record-buf stores (rip-relative store with u64 offset, proven at pdxsock main.pdx L1912 for [reg + offset] and sys_semantic_send.pdx L214 for rip-relative). Labels prefixed `mkdir_` (mkdir_loop_head, mkdir_use_raw_absolute, mkdir_alen_top/done, mkdir_do_resolve, mkdir_ulen_top/done, mkdir_sep_done, mkdir_cpy_cwd_top/done, mkdir_cpy_user_start/top/done, mkdir_call_sys_mkdir, mkdir_all_ok, mkdir_fail, mkdir_missing_operand, mkdir_dot_error, mkdir_getcwd_fail, mkdir_path_too_long) to dodge paideia-as reserved keywords (`loop`, `if`, `let`, `fn`, `pub`, `mut`, `struct`, `structure`, `unsafe`, `block`). @no_frame because every terminal path ends in sys_exit; entry rsp%16==0 per the PVH loader contract.",
      block: {
        // ==========================================================
        // Phase 0 -- argc guard.
        // ==========================================================
        cmp rdi, 2;
        jl  mkdir_missing_operand;

        mov rbx, rdi;                          // rbx = argc
        mov r12, rsi;                          // r12 = argv base
        mov r13, 1;                            // r13 = i (skip argv[0])

        // ==========================================================
        // v1.2.0 (#30): pre-fill invariant record fields.
        //
        // mode (0x1ED = 0755) and status (0) never change across
        // iterations at v1.2.0. path_ptr and path_len are set per
        // iteration before the sys_mkdir call (see mkdir_use_raw_
        // absolute and mkdir_cpy_user_done arms below). r11 is safe
        // as a base pointer here: entry to _start is between syscalls
        // and every use of r11 up to mkdir_call_sys_mkdir is
        // syscall-free scratch (per the register-plan header).
        // ==========================================================
        lea r11, [rip + _mkdir_record_buf];
        mov rax, 0x1ED;
        mov [r11 + 16], rax;                   // mode = 0755
        xor rax, rax;
        mov [r11 + 24], rax;                   // status = 0 (success only)

        // ==========================================================
        // Phase 1 -- per-positional loop.
        // ==========================================================

      mkdir_loop_head:
        cmp r13, rbx;
        jge mkdir_all_ok;

        // Raw argv[i] pointer. Own-aspace per execve ABI.
        mov r15, [r12 + r13*8];                // r15 = raw path ptr

        // Classify first byte.
        xor rax, rax;
        mov_b rax, [r15];
        cmp rax, 0x2F;                         // '/'
        je  mkdir_use_raw_absolute;

        cmp rax, 0x2E;                         // '.'
        jne mkdir_do_resolve;

        // First byte is '.'; check for exactly "." (byte 1 == NUL).
        xor rcx, rcx;
        mov_b rcx, [r15 + 1];
        cmp rcx, 0;
        je  mkdir_dot_error;
        // else: ".foo" / "./bar" / ".." -- treat as relative.
        jmp mkdir_do_resolve;

        // ==========================================================
        // Absolute-path fast path: rdi = argv[i] directly.
        //
        // v1.2.0 (#30): before entering the shared sys_mkdir call
        // site we compute strlen(argv[i]) into r9 (capped at 255, same
        // MK_PATH_TOO_LONG exit as the relative-path arm) so the
        // record marshalled after a successful sys_mkdir carries the
        // real byte count. This mirrors the ulen loop in the
        // relative-path arm verbatim (mkdir_ulen_top .. mkdir_ulen_done)
        // — same byte-load pattern (xor rax, rax; mov_b rax, [ptr]),
        // same 255-byte cap, same MK_PATH_TOO_LONG exit.
        // ==========================================================

      mkdir_use_raw_absolute:
        // Inline bounded strlen(r15), cap at 255. r9 = user_len.
        xor r9, r9;
      mkdir_alen_top:
        cmp r9, 255;
        jae mkdir_path_too_long;
        xor rax, rax;
        mov_b rax, [r15 + r9*1];
        cmp rax, 0;
        je  mkdir_alen_done;
        add r9, 1;
        jmp mkdir_alen_top;

      mkdir_alen_done:
        // Stash record fields for the sys_semantic_send emit after
        // the successful sys_mkdir. path_ptr = argv[i] pointer;
        // path_len = strlen just computed. r11 is safe scratch here
        // (no live value between the absolute-path classification
        // and the sys_mkdir call).
        lea r11, [rip + _mkdir_record_buf];
        mov [r11 + 0], r15;                    // path_ptr = argv[i]
        mov [r11 + 8], r9;                     // path_len

        mov rdi, r15;
        jmp mkdir_call_sys_mkdir;

        // ==========================================================
        // Relative-path resolve: cwd + '/' + argv[i] -> resolved.
        // ==========================================================

      mkdir_do_resolve:
        // sys_getcwd(&_mkdir_cwd_scratch, 256)
        lea rdi, [rip + _mkdir_cwd_scratch];
        mov rsi, 256;
        mov rax, 86;                           // SC+ ID 86 = sys_getcwd
        syscall;

        cmp rax, 0;
        jl  mkdir_getcwd_fail;

        // r8 = cwd_len (excluding NUL).
        mov r8, rax;
        sub r8, 1;

        // Inline bounded strlen(r15), cap at 255. r9 = user_len.
        xor r9, r9;
      mkdir_ulen_top:
        cmp r9, 255;
        jae mkdir_path_too_long;
        xor rax, rax;
        mov_b rax, [r15 + r9*1];
        cmp rax, 0;
        je  mkdir_ulen_done;
        add r9, 1;
        jmp mkdir_ulen_top;

      mkdir_ulen_done:
        // Compute separator length: sep = (cwd is not "/") ? 1 : 0.
        // r10 will hold sep.
        mov r10, 1;                            // default: need '/'
        cmp r8, 1;
        jne mkdir_sep_done;                    // cwd_len != 1 -> keep sep=1

        // cwd_len == 1: check whether the single byte is '/'.
        lea rax, [rip + _mkdir_cwd_scratch];
        xor rdx, rdx;
        mov_b rdx, [rax];
        cmp rdx, 0x2F;
        jne mkdir_sep_done;                    // single byte != '/' -> sep=1
        xor r10, r10;                          // cwd == "/" -> sep = 0

      mkdir_sep_done:
        // total_len = cwd_len + sep + user_len. Must fit with NUL at
        // index total_len, so total_len <= 255.
        mov rdx, r8;
        add rdx, r10;
        add rdx, r9;
        cmp rdx, 255;
        ja  mkdir_path_too_long;

        // ---- Copy cwd bytes into resolved scratch ----
        lea rdi, [rip + _mkdir_resolved_scratch];
        lea rsi, [rip + _mkdir_cwd_scratch];
        xor r11, r11;                          // r11 = write cursor
      mkdir_cpy_cwd_top:
        cmp r11, r8;
        jae mkdir_cpy_cwd_done;
        xor rax, rax;
        mov_b rax, [rsi + r11*1];
        mov_b [rdi + r11*1], rax;
        add r11, 1;
        jmp mkdir_cpy_cwd_top;

      mkdir_cpy_cwd_done:
        // ---- Emit separator if needed ----
        cmp r10, 0;
        je  mkdir_cpy_user_start;
        mov rax, 0x2F;                         // '/'
        mov_b [rdi + r11*1], rax;
        add r11, 1;

      mkdir_cpy_user_start:
        // ---- Copy user bytes ----
        xor rcx, rcx;                          // rcx = user read index
      mkdir_cpy_user_top:
        cmp rcx, r9;
        jae mkdir_cpy_user_done;
        xor rdx, rdx;
        mov_b rdx, [r15 + rcx*1];
        mov_b [rdi + r11*1], rdx;
        add r11, 1;
        add rcx, 1;
        jmp mkdir_cpy_user_top;

      mkdir_cpy_user_done:
        // NUL-terminate at [rdi + r11].
        xor rax, rax;
        mov_b [rdi + r11*1], rax;

        // v1.2.0 (#30): stash record fields for the sys_semantic_send
        // emit after the successful sys_mkdir. path_ptr = interior
        // pointer into _mkdir_resolved_scratch (mkdir owns that memory
        // for the invocation); path_len = the r11 cursor we finished
        // the copy at (excludes NUL, matches wire convention). Uses
        // rax as the record_buf base pointer here because rdi is still
        // pinned to _mkdir_resolved_scratch (we hand that same pointer
        // to sys_mkdir below).
        lea rax, [rip + _mkdir_record_buf];
        mov [rax + 0], rdi;                    // path_ptr = &_mkdir_resolved_scratch
        mov [rax + 8], r11;                    // path_len (excludes NUL)

        // rdi already points to _mkdir_resolved_scratch -- fall through
        // to the sys_mkdir call site with rdi holding the resolved
        // absolute path.
        lea rdi, [rip + _mkdir_resolved_scratch];

        // ==========================================================
        // Common sys_mkdir call site.
        // ==========================================================

      mkdir_call_sys_mkdir:
        mov rsi, 255;                          // walker CAP hint
        mov rdx, 0x1ED;                        // mode 0755
        mov rax, 79;                           // SC+ ID 79 = sys_mkdir
        syscall;

        cmp rax, 0;
        jne mkdir_fail;

        // ==========================================================
        // v1.2.0 (#30): emit MkdirRecord@0.1 via sys_semantic_send.
        //
        // Best-effort ring emission. The record buffer has already
        // been fully composed (path_ptr, path_len before this call;
        // mode, status once at _start entry). Schema tag is the
        // magic u64 0x4D6B646972526501 ("MkdirRe\x01"). Record length
        // is 32 (well inside [1, 240], the kernel-side per-record
        // cap at SSS_MAX_RECORD).
        //
        // Return value (0 / -EFAULT / -EINVAL) is intentionally
        // discarded: (a) the directory is already on disk so a
        // ring-refusal cannot roll it back, and (b) the 32-byte
        // static rip-relative buffer never fails user_ptr_ok and
        // 32 sits inside the length gate — a nonzero return here
        // would be a marshalling bug in this file, not a per-run
        // condition the caller can act on. Same discipline pdxsock's
        // v1.1-B session-close emit follows (src/main.pdx L1917-L1929).
        //
        // Encoder discipline: `mov rdi, imm64` is the movabs form
        // (proven at sys_semantic_send.pdx line 221 for errno
        // constants); rip-relative lea for rsi (proven at pdxsock
        // main.pdx L1926); every other operand is imm8 or imm32.
        // ==========================================================
        mov rdi, 0x4D6B646972526501;           // schema tag "MkdirRe\x01"
        lea rsi, [rip + _mkdir_record_buf];
        mov rdx, 32;                           // record_len
        mov rax, 115;                          // SC+ ID 115 = sys_semantic_send
        syscall;

        // Success on this positional; advance i and loop.
        add r13, 1;
        jmp mkdir_loop_head;

        // ==========================================================
        // Terminators.
        // ==========================================================

      mkdir_all_ok:
        xor rdi, rdi;
        mov rax, 60;                           // SC+ ID 60 = sys_exit
        syscall;
        hlt;

      mkdir_fail:
        mov r14, rax;                          // save -errno
        lea rdi, [rip + err_mkdir_fail_msg];
        mov rsi, 21;                           // err_mkdir_fail_len
        mov rax, 12;                           // SC+ ID 12 = sys_debug_puts
        syscall;
        mov rdi, r14;
        mov rax, 60;
        syscall;
        hlt;

      mkdir_missing_operand:
        lea rdi, [rip + err_no_operand_msg];
        mov rsi, 23;                           // err_no_operand_len
        mov rax, 12;
        syscall;
        mov rdi, 2;                            // MK_MISSING_PATH
        mov rax, 60;
        syscall;
        hlt;

      mkdir_dot_error:
        lea rdi, [rip + err_dot_cwd_msg];
        mov rsi, 27;                           // err_dot_cwd_len
        mov rax, 12;
        syscall;
        mov rdi, 1;                            // MK_DOT_CWD_NONSENSICAL
        mov rax, 60;
        syscall;
        hlt;

      mkdir_getcwd_fail:
        mov r14, rax;                          // preserve -errno
        lea rdi, [rip + err_getcwd_fail_msg];
        mov rsi, 21;                           // err_getcwd_fail_len
        mov rax, 12;
        syscall;
        mov rdi, r14;                          // -errno passthrough
        mov rax, 60;
        syscall;
        hlt;

      mkdir_path_too_long:
        lea rdi, [rip + err_path_too_long_msg];
        mov rsi, 30;                           // err_path_too_long_len
        mov rax, 12;
        syscall;
        mov rdi, 4;                            // MK_PATH_TOO_LONG
        mov rax, 60;
        syscall;
        hlt
      }
    } @no_frame
}
