// src/mkdir.pdx — mkdir.M1-001 + M1-002 + M1-003
// Mkdir module: _init_caps sidecar declaration + _start orchestrator +
// argv wire-up + flag walk + mkdir_one create sequence + mkdir_run
// positional walk. M1-001 landed the scaffold shape (ring3 marker +
// sys_exit(0)); M1-002 lands the argv surface (Parser::parse_argv,
// well-known flag walk over `-p / -v / --dry-run`, missing-operand
// rejection); M1-003 lands the single-level create sequence (multi-
// level guard, --dry-run short-circuit, and the placeholder TXN-open →
// create-dir → TXN-commit chain that waits on the M2 substrate).
//
// See design/architecture.md §2 (module boundary), §3 (_start shape),
// §5 (flag semantics table), and §6 (sidecar cap slot map).
// Upstream: design/tooling/r49-r50-plan.md §5.9 (paideia-os).

module Mkdir = structure {

  // ============================================================================
  // _init_caps sidecar — FOUR entries. Layout per
  // design/loader/init-caps-sidecar.md §2 (paideia-os) and
  // src/kernel/core/loader/init_caps.pdx (R20b.M4).
  //
  // Word packing per entry (16 bytes each):
  //   word0 = (rights << 32) | (kind << 16) | slot
  //   word1 = target_ptr  (kind-specific; 0 at M1 — populated by the
  //           loader from the shell's cap_transfer at spawn time)
  //
  // Entry 0: slot=0, kind=KIND_PDXFS_TXN(0x196), rights=INVOKE|OBSERVE
  //   INVOKE=0x008, OBSERVE=0x400 → 0x408.
  // Entry 1: slot=1, kind=KIND_PDXFS_FILE(0x195), rights=INVOKE(0x008)
  // Entry 2: slot=2, kind=KIND_USER(0x190), rights=INVOKE(0x008)
  // Entry 3: slot=3, kind=KIND_IPC_ENDPOINT(0x005), rights=WRITE|INVOKE
  //   WRITE=0x002, INVOKE=0x008 → 0x00A.
  //
  // target_ptr at M1 is 0 for every row — the shell fills it via
  // sys_cap_transfer before the exec landing. Matches echo_client's
  // sidecar shape at R31.M2-1590 (endpoint_ids were baked in there
  // because the loader claimed both endpoints by id; here the parent
  // shell owns the resolution).
  // ============================================================================

  pub let _init_caps_count : u64 = 4

  pub let _init_caps : [u64; 8] = [
    // Entry 0 — KIND_PDXFS_TXN at slot 0.
    0x0000040801960000,
    0x0000000000000000,
    // Entry 1 — KIND_PDXFS_FILE at slot 1.
    0x0000000801950001,
    0x0000000000000000,
    // Entry 2 — KIND_USER at slot 2.
    0x0000000801900002,
    0x0000000000000000,
    // Entry 3 — KIND_IPC_ENDPOINT at slot 3.
    0x0000000A00050003,
    0x0000000000000000
  ]

  // ============================================================================
  // Static stderr / diagnostic strings.
  //
  // sys_debug_puts (SC+ ID 12) is the M1 stderr proxy; M3-001 replaces
  // every call site with a schema-tagged send_record over the
  // KIND_IPC_ENDPOINT at slot 3.
  //
  // Each string is NUL-terminated so a future emit_stderr overload that
  // takes a NUL-terminated pointer can share the byte storage; the
  // paired *_len constants are what M1 passes to sys_debug_puts today.
  // ============================================================================

  pub let ring3_msg           : [u8; 20] = "mkdir: M1 ring3 ok\n\0"
  pub let ring3_len           : u64 = 19

  pub let err_argv_msg        : [u8; 26] = "mkdir: argv parse error\n\0\0"
  pub let err_argv_len        : u64 = 24

  pub let err_no_operand_msg  : [u8; 24] = "mkdir: missing operand\n\0"
  pub let err_no_operand_len  : u64 = 23

  // ---- M1-003 mkdir_one diagnostic strings ----
  pub let err_multi_msg       : [u8; 40] = "mkdir: multi-level path needs M2 (-p)\n\0\0"
  pub let err_multi_len       : u64 = 38

  pub let err_txn_open_msg    : [u8; 24] = "mkdir: TXN open failed\n\0"
  pub let err_txn_open_len    : u64 = 23

  pub let err_mkdir_msg       : [u8; 22] = "mkdir: create failed\n\0"
  pub let err_mkdir_len       : u64 = 21

  pub let err_commit_msg      : [u8; 26] = "mkdir: TXN commit failed\n\0"
  pub let err_commit_len      : u64 = 25

  // ============================================================================
  // Bootstrap argv (mkdir.M1-002 self-test)
  //
  // Real argv arrives via the shell at mkdir.M2 once shell.M4 publishes
  // the argv-in-sidecar wire. Until then _start builds a static argv
  // that exercises the parse path end to end — one short flag (-v),
  // one long flag (--dry-run), and one positional (a). The three
  // flag/positional strings live in .rodata; the argv pointer array
  // (`argv_bootstrap_ptrs`) is built at _start entry via three lea+mov
  // stores. Parser::parse_argv walks the pointer array and does NOT
  // mutate the strings themselves at the shapes M1-002 exercises (no
  // `--foo=bar` form appears here), so the strings staying .rodata is
  // safe.
  //
  // Bootstrap invocation shape (three args, matches `mkdir -v --dry-run a`):
  //   argv[0] = "-v"          → short flag, sets MkdirState::flag_v
  //   argv[1] = "--dry-run"   → long flag, sets MkdirState::flag_dry_run
  //   argv[2] = "a"           → positional, becomes pos_ptrs[0]
  // The `-p` recognition is exercised via the byte-compare table in
  // parse_flags_from_argv even though the bootstrap argv does not name
  // it; the recognizer is data-driven and there is no code branch that
  // fires only when `-p` is present at M1-002.
  // ============================================================================

  pub let argv_flag_v         : [u8; 3]  = "-v\0"
  pub let argv_flag_dry_run   : [u8; 10] = "--dry-run\0"
  pub let argv_positional_a   : [u8; 2]  = "a\0"

  pub let mut argv_bootstrap_ptrs : [u64; 3] = uninit @align(8)
  pub let argv_bootstrap_argc     : u64 = 3

  // ============================================================================
  // Well-known flag names — byte-exact compare table for
  // parse_flags_from_argv. Every entry is NUL-terminated; the compare
  // walks each byte in order and rejects on the first mismatch.
  //
  // libpdx-argv predates any strcmp helper (see the inline pdx-schema
  // byte compare in libpdx-argv/src/parser.pdx L151..L161). We repeat
  // the pattern here rather than pull in a strcmp dependency; when
  // libpdx-argv.M2 factors `well_known_flag_id(name) → i64`, every
  // consumer switches to it and this table disappears.
  //
  // Short-flag names are one letter (parse_argv stores just the letter,
  // not the leading '-', at flag_names[k] after skipping the hyphen).
  // Long-flag names are the post-`--` string (parse_argv stores that
  // pointer at flag_names[k] with the leading `--` already stripped).
  // ============================================================================

  pub let flag_p_name         : [u8; 2]  = "p\0"
  pub let flag_v_name         : [u8; 2]  = "v\0"
  pub let flag_dry_run_name   : [u8; 8]  = "dry-run\0"

  // ============================================================================
  // emit_stderr(buf, len)
  //
  // Signature: emit_stderr : (u64, u64) -> u64 !{mem, sysreg} @{}
  //   rdi = buf pointer (u8*)
  //   rsi = byte count
  //   rax = sys_debug_puts return (echoed count on success)
  //
  // Thin wrapper around sys_debug_puts (SC+ ID 12). Kept as its own
  // symbol so mkdir.M3-001's rewrite is a one-line body swap (from
  // sys_debug_puts to a semantic-pipe send_record) at exactly one call
  // site rather than every diagnostic site. Same idiom libpdx-cap uses
  // for cap_manifest_verify — freeze the signature at M1, evolve the
  // body across milestones.
  //
  // Register plan (leaf, all caller-save; no push/pop parity):
  //   rax = SC+ ID / syscall return
  //   rdi = buf (untouched — passed straight through)
  //   rsi = len (untouched — passed straight through)
  // ============================================================================
  pub let emit_stderr : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "mkdir.M1-002 emit_stderr — thin sys_debug_puts wrapper. SC+ ID 12 loaded into rax; rdi/rsi come straight from the SysV caller (arity 2 < 4, no arg shuffle). Kept as its own symbol so mkdir.M3-001 can swap sys_debug_puts for a semantic-pipe send_record at exactly one call site rather than every diagnostic emit. Leaf function; no callee-save touched; no push/pop parity to preserve; no cmp; no test mnemonic.",
      block: {
        mov rax, 12;                              // SC+ ID 12 = sys_debug_puts
        syscall;
        ret
      }
    }

  // ============================================================================
  // parse_flags_from_argv()
  //
  // Walk ParsedArgs::flag_names[0..flag_count] and for each entry
  // byte-compare against the three well-known names (`p`, `v`,
  // `dry-run`). On a match, write 1 into the corresponding MkdirState
  // slot (`flag_p`, `flag_v`, `flag_dry_run`). Unknown flags at M1-002
  // are silently ignored — the 9-flag standard-vocabulary rejection
  // path lands at libpdx-argv.M2-002.
  //
  // Called AFTER Parser::parse_argv has populated ParsedArgs; must be
  // called BEFORE mkdir_run so mkdir_one sees the correct flag state.
  //
  // Register plan (leaf, all caller-save):
  //   rax = byte load scratch (always preceded by xor rax, rax per #1248)
  //   rcx = flag_names[k] name pointer
  //   r8  = k (loop counter over flag_count)
  //   r9  = flag_count (loaded once at head)
  //   r10 = byte offset into the current name during the byte compare
  //   r11 = LEA scratch (paideia-as reserved)
  // ============================================================================
  pub let parse_flags_from_argv : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "mkdir.M1-002 parse_flags_from_argv. Walks ParsedArgs::flag_names[0..flag_count] and byte-matches each name against `p` / `v` / `dry-run` (the three flags mkdir recognizes at M1). Sets MkdirState::flag_p / flag_v / flag_dry_run to 1 on match. Unknown flags silently ignored — libpdx-argv.M2-002 lands the 9-flag standard-vocabulary rejection path; until then the recognizer is permissive so an over-argument does not sink the whole invocation. paideia-as conformance: every byte load is `xor rax,rax; mov_b rax,[ptr]` (#1248 mitigation); every cmp reg,imm is a single-byte ASCII value ≤ 0x7A; r11 is scratch (LEA); no push/pop parity (leaf); no test mnemonic. Label prefix `mkdir_pff_` avoids every paideia-as reserved keyword.",
      block: {
        // Load flag_count once — the loop bound.
        lea r11, [rip + flag_count];
        mov r9, [r11];

        // r8 = k = 0
        xor r8, r8;

      mkdir_pff_loop_head:
        cmp r8, r9;
        jge mkdir_pff_done;

        // rcx = flag_names[k]
        lea r11, [rip + flag_names];
        mov rcx, [r11 + r8*8];

        // ---- Try short flag `p`: name is [rcx] == 'p' && [rcx+1] == NUL ----
        xor rax, rax;
        mov_b rax, [rcx];
        cmp rax, 0x70;                            // 'p'
        jne mkdir_pff_try_v;

        xor rax, rax;
        mov_b rax, [rcx + 1];
        cmp rax, 0;
        jne mkdir_pff_try_dry_run;                // 'p...' with more bytes — not our -p

        mov rax, 1;
        lea r11, [rip + flag_p];
        mov [r11], rax;
        jmp mkdir_pff_advance;

      mkdir_pff_try_v:
        // ---- Try short flag `v`: name is [rcx] == 'v' && [rcx+1] == NUL ----
        // rax already holds byte0 from the failed `p` compare, so we
        // reload rather than assume — cheaper to reload than to branch.
        xor rax, rax;
        mov_b rax, [rcx];
        cmp rax, 0x76;                            // 'v'
        jne mkdir_pff_try_dry_run;

        xor rax, rax;
        mov_b rax, [rcx + 1];
        cmp rax, 0;
        jne mkdir_pff_try_dry_run;

        mov rax, 1;
        lea r11, [rip + flag_v];
        mov [r11], rax;
        jmp mkdir_pff_advance;

      mkdir_pff_try_dry_run:
        // ---- Try long flag `dry-run`: byte-compare 7 chars + NUL ----
        // Inline byte-by-byte compare matching libpdx-argv's own
        // pdx-schema compare pattern (parser.pdx L151..L161).
        xor rax, rax; mov_b rax, [rcx + 0]; cmp rax, 0x64; jne mkdir_pff_advance;  // 'd'
        xor rax, rax; mov_b rax, [rcx + 1]; cmp rax, 0x72; jne mkdir_pff_advance;  // 'r'
        xor rax, rax; mov_b rax, [rcx + 2]; cmp rax, 0x79; jne mkdir_pff_advance;  // 'y'
        xor rax, rax; mov_b rax, [rcx + 3]; cmp rax, 0x2D; jne mkdir_pff_advance;  // '-'
        xor rax, rax; mov_b rax, [rcx + 4]; cmp rax, 0x72; jne mkdir_pff_advance;  // 'r'
        xor rax, rax; mov_b rax, [rcx + 5]; cmp rax, 0x75; jne mkdir_pff_advance;  // 'u'
        xor rax, rax; mov_b rax, [rcx + 6]; cmp rax, 0x6E; jne mkdir_pff_advance;  // 'n'
        xor rax, rax; mov_b rax, [rcx + 7]; cmp rax, 0;    jne mkdir_pff_advance;  // NUL

        mov rax, 1;
        lea r11, [rip + flag_dry_run];
        mov [r11], rax;

      mkdir_pff_advance:
        add r8, 1;
        jmp mkdir_pff_loop_head;

      mkdir_pff_done:
        ret
      }
    }

  // ============================================================================
  // mkdir_one(path) -> rc                                    (mkdir.M1-003)
  //
  // Signature: mkdir_one : (u64) -> u64 !{mem, sysreg} @{cap}
  //   rdi = path — NUL-terminated string (a live pointer into argv or a
  //                positional slot in ParsedArgs::pos_ptrs)
  //   rax = MK_OK                        (0)
  //       | MK_MULTI_LEVEL_UNSUPPORTED   (3)  — path contains '/'
  //       | MK_TXN_OPEN_FAIL             (4)  — sys_cap_invoke(SLOT_TXN,...)
  //       | MK_MKDIR_FAIL                (5)  — sys_cap_invoke(SLOT_PARENT_FILE,...)
  //       | MK_TXN_COMMIT_FAIL           (6)  — sys_cap_invoke(SLOT_TXN,...) commit
  //
  // Steps (per design/architecture.md §4):
  //   1. Multi-level guard. Any '/' in path → MK_MULTI_LEVEL_UNSUPPORTED
  //      at M1 (even with -p; multi-level TXN atomic create lands at
  //      mkdir.M2-001, not M1-003).
  //   2. -v diagnostic. DEFERRED at M1-003 to keep the file free of a
  //      strlen helper; verbose emit lands with the CreatedDirRecord
  //      text-render at mkdir.M3-001 (see design/architecture.md §5).
  //   3. --dry-run short-circuit. Return MK_OK without touching either
  //      cap. This is the smoke-witness path at M1 — the bootstrap
  //      argv includes --dry-run so mkdir_one reaches MK_OK without
  //      needing the (not-yet-implemented) create-dir op on
  //      KIND_PDXFS_FILE.
  //   4. TXN open — placeholder sys_cap_invoke(SLOT_TXN=0,
  //      PXT_OP_QUERY_ID=0). Real "open TXN" op lands kernel-side
  //      alongside mkdir.M2-001; QUERY_ID exercises the cap dispatch
  //      path so a mis-seeded slot 0 surfaces here at M1 rather than
  //      at M2. Negative rax → MK_TXN_OPEN_FAIL.
  //   5. Create dir — placeholder sys_cap_invoke(SLOT_PARENT_FILE=1,
  //      PFF_OP_DEBUG_PRINT=6). Real create-dir op (with the path
  //      string marshalled through the sidecar or an IPC endpoint)
  //      lands at mkdir.M2. Negative rax → MK_MKDIR_FAIL.
  //   6. Cap-tail owner — DEFERRED to mkdir.M2-003. The invoker's
  //      KIND_USER cap sits in slot 2 unread at M1-003.
  //   7. TXN commit — placeholder sys_cap_invoke(SLOT_TXN=0,
  //      PXT_OP_QUERY_STATE=4). Real commit op lands at mkdir.M2.
  //      Negative rax → MK_TXN_COMMIT_FAIL.
  //
  // Register plan (SysV push/pop parity preserved):
  //   push rbx        — one push aligns rsp for nested `call`s. rbx
  //                     holds `path` across every emit_stderr /
  //                     syscall so the caller-save clobber does not
  //                     lose the pointer.
  //   rax  = byte load / syscall return / MK_* return value
  //   rcx  = path walk cursor (Step 1)
  //   rdi/rsi = syscall args (SysV) / emit_stderr args
  //   r11  = LEA scratch (paideia-as reserved)
  //   pop rbx — restores caller's rbx before ret.
  //
  // Effects / capabilities:
  //   mem     — path byte scans + emit_stderr writes.
  //   sysreg  — every sys_cap_invoke SYSCALL.
  //   @{cap}  — sys_cap_invoke is cap-gated.
  // ============================================================================
  pub let mkdir_one : (u64) -> u64 !{mem, sysreg} @{cap} =
    fn (path: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "mkdir.M1-003 mkdir_one — single-level create sequence. Steps: (1) walk path bytes for '/' — any hit returns MK_MULTI_LEVEL_UNSUPPORTED at M1 (multi-level TXN is M2-001, even with -p; the flag is stored + honoured for the recognizer path but has no code branch at M1); (2) -v diagnostic deferred to mkdir.M3-001 (no strlen helper wired at M1); (3) --dry-run short-circuit returns MK_OK without touching either cap so the M1 smoke witness reaches exit 0 without needing the still-being-built kernel-side create-dir op; (4) placeholder sys_cap_invoke(SLOT_TXN, PXT_OP_QUERY_ID) — exercises cap dispatch through KIND_PDXFS_TXN, negative rax → MK_TXN_OPEN_FAIL; (5) placeholder sys_cap_invoke(SLOT_PARENT_FILE, PFF_OP_DEBUG_PRINT) — exercises cap dispatch through KIND_PDXFS_FILE, negative rax → MK_MKDIR_FAIL; (6) cap-tail owner write deferred to M2-003; (7) placeholder sys_cap_invoke(SLOT_TXN, PXT_OP_QUERY_STATE) — TXN commit placeholder, negative rax → MK_TXN_COMMIT_FAIL. Same shape libpdx-cap M1 uses for cap_manifest_verify — freeze the signature at M1 so the M2 body-edit changes zero call sites. paideia-as conformance: one push rbx to align rsp AND preserve path across nested calls (single push = rsp aligned per SysV, verified by count); byte loads via xor rax,rax; mov_b (#1248 mitigation); every cmp reg,imm ≤ 0x7FFFFFFF (max 0x2F = '/'); r11 scratch. Label prefix mkdir_one_ avoids every paideia-as reserved keyword.",
      block: {
        // ---- Prologue: 1 push rbx aligns rsp to 16 for nested calls. ----
        push rbx;
        mov rbx, rdi;                             // rbx = path (survives calls)

        // ---- Step 1: multi-level guard. Walk path bytes for '/'. ----
        mov rcx, rbx;

      mkdir_one_scan_head:
        xor rax, rax;
        mov_b rax, [rcx];
        cmp rax, 0;
        je  mkdir_one_scan_done;
        cmp rax, 0x2F;                            // '/'
        je  mkdir_one_reject_multi;
        add rcx, 1;
        jmp mkdir_one_scan_head;

      mkdir_one_reject_multi:
        lea rdi, [rip + err_multi_msg];
        mov rsi, 38;                              // err_multi_len
        call emit_stderr;
        mov rax, 3;                               // MK_MULTI_LEVEL_UNSUPPORTED
        jmp mkdir_one_epilogue;

      mkdir_one_scan_done:
        // ---- Step 2: -v emission deferred (M3-001). ----

        // ---- Step 3: --dry-run short-circuit. ----
        lea r11, [rip + flag_dry_run];
        mov rax, [r11];
        cmp rax, 0;
        je  mkdir_one_do_txn_open;

        xor rax, rax;                             // MK_OK
        jmp mkdir_one_epilogue;

        // ---- Step 4: TXN open (placeholder sys_cap_invoke). ----
      mkdir_one_do_txn_open:
        xor rdi, rdi;                             // SLOT_TXN = 0
        xor rsi, rsi;                             // PXT_OP_QUERY_ID = 0
        mov rax, 4;                               // SC+ ID 4 = sys_cap_invoke
        syscall;
        cmp rax, 0;
        jl  mkdir_one_txn_open_fail;

        // ---- Step 5: create dir (placeholder sys_cap_invoke). ----
        mov rdi, 1;                               // SLOT_PARENT_FILE = 1
        mov rsi, 6;                               // PFF_OP_DEBUG_PRINT = 6
        mov rax, 4;                               // SC+ ID 4 = sys_cap_invoke
        syscall;
        cmp rax, 0;
        jl  mkdir_one_mkdir_fail;

        // ---- Step 6: cap-tail owner write — DEFERRED to M2-003. ----

        // ---- Step 7: TXN commit (placeholder sys_cap_invoke). ----
        xor rdi, rdi;                             // SLOT_TXN = 0
        mov rsi, 4;                               // PXT_OP_QUERY_STATE = 4
        mov rax, 4;                               // SC+ ID 4 = sys_cap_invoke
        syscall;
        cmp rax, 0;
        jl  mkdir_one_commit_fail;

        xor rax, rax;                             // MK_OK
        jmp mkdir_one_epilogue;

      mkdir_one_txn_open_fail:
        lea rdi, [rip + err_txn_open_msg];
        mov rsi, 23;                              // err_txn_open_len
        call emit_stderr;
        mov rax, 4;                               // MK_TXN_OPEN_FAIL
        jmp mkdir_one_epilogue;

      mkdir_one_mkdir_fail:
        lea rdi, [rip + err_mkdir_msg];
        mov rsi, 21;                              // err_mkdir_len
        call emit_stderr;
        mov rax, 5;                               // MK_MKDIR_FAIL
        jmp mkdir_one_epilogue;

      mkdir_one_commit_fail:
        lea rdi, [rip + err_commit_msg];
        mov rsi, 25;                              // err_commit_len
        call emit_stderr;
        mov rax, 6;                               // MK_TXN_COMMIT_FAIL
        jmp mkdir_one_epilogue;

      mkdir_one_epilogue:
        pop rbx;                                  // restore caller's rbx
        ret
      }
    }

  // ============================================================================
  // mkdir_run() — walk pos_ptrs[0..pos_count], call mkdir_one on each.
  //
  // Signature: mkdir_run : () -> () !{mem, sysreg} @{cap}
  //
  // On the first non-MK_OK return from mkdir_one, records the code in
  // MkdirState::exit_code and the offending index in
  // MkdirState::err_pos_index and stops the walk (fail-fast — no
  // partial "some created, some not" state at M1).
  //
  // Uses MkdirState::mkdir_run_i as loop-counter storage so the counter
  // survives mkdir_one calls without a callee-save push. Safe at M1
  // because mkdir_run runs at most once per _start invocation.
  //
  // Register plan (leaf-ish; no callee-save needed thanks to the .bss
  // loop counter):
  //   rax = index / mkdir_one return
  //   rcx = pos_count (bound)
  //   rdi = pos_ptrs[i] (arg to mkdir_one)
  //   r11 = LEA scratch
  // ============================================================================
  pub let mkdir_run : () -> () !{mem, sysreg} @{cap} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap},
      justification: "mkdir.M1-003 mkdir_run — positional walk. Iterates MkdirState::mkdir_run_i over 0..ParsedArgs::pos_count; each iteration loads pos_ptrs[i] and calls mkdir_one. On first non-MK_OK return records MkdirState::exit_code + err_pos_index and returns (fail-fast — no partial completion at M1). Loop counter lives in .bss so it survives mkdir_one's clobber of every caller-save reg — same trick dispatch.pdx's echo_builtin uses for its echo_idx slot (see paideia-os src/user/dispatch.pdx L165 justification). paideia-as conformance: r11 scratch (LEA); every cmp reg,imm ≤ 0x7FFFFFFF; no `test` mnemonic; leaf-with-nested-calls but no callee-save state so no push/pop parity needed. Labels prefixed mkdir_run_.",
      block: {
        // Initialize i = 0.
        xor rax, rax;
        lea r11, [rip + mkdir_run_i];
        mov [r11], rax;

      mkdir_run_loop_head:
        lea r11, [rip + mkdir_run_i];
        mov rax, [r11];

        lea r11, [rip + pos_count];
        mov rcx, [r11];

        cmp rax, rcx;
        jge mkdir_run_done;

        // rdi = pos_ptrs[i]
        lea r11, [rip + pos_ptrs];
        mov rdi, [r11 + rax*8];
        call mkdir_one;
        // rax = mkdir_one return code.

        cmp rax, 0;
        je  mkdir_run_advance;

        // Non-OK: record + stop.
        lea r11, [rip + exit_code];
        mov [r11], rax;

        lea r11, [rip + mkdir_run_i];
        mov rcx, [r11];
        lea r11, [rip + err_pos_index];
        mov [r11], rcx;
        ret

      mkdir_run_advance:
        lea r11, [rip + mkdir_run_i];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        jmp mkdir_run_loop_head;

      mkdir_run_done:
        ret
      }
    }

  // ============================================================================
  // _start — user program entry point. Never returns (ends in sys_exit).
  //
  // M1-003 shape (this milestone):
  //   Step 0  ring3 proof-of-life marker on sys_debug_puts.
  //   Step 1  mkdir_state_reset()   — clear MkdirState singletons.
  //   Step 2  reset()               — clear ParsedArgs singletons (libpdx-argv).
  //   Step 3  Build argv_bootstrap_ptrs from the three static strings.
  //   Step 4  parse_argv(argv, argc). On error → emit err_argv_msg and
  //           sys_exit(MK_ARGV_ERR).
  //   Step 5  parse_flags_from_argv() — populate MkdirState::flag_*.
  //   Step 6  Check ParsedArgs::pos_count. If zero → emit err_no_operand_msg
  //           and sys_exit(MK_MISSING_PATH).
  //   Step 7  mkdir_run() — walk positionals, invoke mkdir_one per path.
  //           On first failure records MkdirState::exit_code + err_pos_index.
  //   Step 8  sys_exit(MkdirState::exit_code) — 0 on all-success, otherwise
  //           the first mkdir_one MK_* return.
  //
  // Register discipline
  // -------------------
  // Straight-line body ending in sys_exit — no callee-save state
  // needed, no SysV push/pop parity to preserve. Each nested call is
  // to a leaf helper that uses only caller-save regs; `syscall` and
  // `call` are both safe at any rsp alignment because none of the
  // callees push additional callee-save (echo_client.pdx precedent).
  //
  // Effects / capabilities
  // ----------------------
  //   mem     — string loads for debug_puts + argv_bootstrap array init.
  //   sysreg  — every SYSCALL.
  //   @{sched} — sys_exit terminates the task (sched teardown).
  // ============================================================================
  pub let _start : () -> () !{mem, sysreg} @{sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {sched},
      justification: "mkdir.M1-003 _start orchestrator. Full argv + create surface: ring3 marker + mkdir_state_reset + libpdx-argv reset + argv_bootstrap build + parse_argv + argv-error diagnostic + parse_flags_from_argv + missing-operand diagnostic + mkdir_run + sys_exit(exit_code). Straight-line, ends in sys_exit — no callee-save touched, no SysV push/pop parity. Every immediate ≤ 0x7FFFFFFF (max seen: 60 sys_exit ID). No `test` mnemonic. Cross-module calls by unqualified linker name (`reset` → libpdx-argv/src/parsed_args.pdx; `parse_argv` → libpdx-argv/src/parser.pdx; `mkdir_state_reset`, `parse_flags_from_argv`, `mkdir_run`, `mkdir_one`, `emit_stderr` → local). Bootstrap argv array is built via three lea+mov stores that observe the paideia-as reserved-scratch rule (r11 always the LEA temp). M1 smoke witness: bootstrap argv `-v --dry-run a` → parse OK → flags {v=1, dry_run=1} → pos_count=1 → mkdir_run calls mkdir_one(\"a\") which short-circuits on --dry-run and returns MK_OK → exit_code=0 → exit(0). Real cap invocation (Steps 4/5/7 of mkdir_one) exercises when a shell hands us a real TXN cap at mkdir.M2.",
      block: {
        // ---- Step 0: ring3 proof-of-life marker. ----
        lea rdi, [rip + ring3_msg];
        mov rsi, 19;                              // ring3_len
        mov rax, 12;                              // SC+ ID 12 = sys_debug_puts
        syscall;

        // ---- Step 1: MkdirState reset. Leaf call. ----
        call mkdir_state_reset;

        // ---- Step 2: ParsedArgs reset (libpdx-argv). Leaf call. ----
        call reset;

        // ---- Step 3: build argv_bootstrap_ptrs (three static entries). ----
        lea rcx, [rip + argv_bootstrap_ptrs];
        lea r11, [rip + argv_flag_v];         mov [rcx + 0],  r11;
        lea r11, [rip + argv_flag_dry_run];   mov [rcx + 8],  r11;
        lea r11, [rip + argv_positional_a];   mov [rcx + 16], r11;

        // ---- Step 4: parse_argv(argv, argc). rdi=argv_ptr, rsi=argc. ----
        lea rdi, [rip + argv_bootstrap_ptrs];
        mov rsi, 3;                               // argv_bootstrap_argc
        call parse_argv;
        // rax = ParsedArgs::ERR_OK (0) on success.

        cmp rax, 0;
        je  mkdir_after_parse_ok;

        // Argv parse error branch: emit diagnostic + sys_exit(MK_ARGV_ERR=1).
        lea rdi, [rip + err_argv_msg];
        mov rsi, 24;                              // err_argv_len
        call emit_stderr;

        mov rdi, 1;                               // MK_ARGV_ERR
        mov rax, 60;                              // SC+ ID 60 = sys_exit
        syscall;

      mkdir_after_parse_ok:
        // ---- Step 5: parse_flags_from_argv. Leaf call. ----
        call parse_flags_from_argv;

        // ---- Step 6: missing-operand check. pos_count from libpdx-argv. ----
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 0;
        jne mkdir_after_operand_ok;

        // Missing operand branch.
        lea rdi, [rip + err_no_operand_msg];
        mov rsi, 23;                              // err_no_operand_len
        call emit_stderr;

        mov rdi, 2;                               // MK_MISSING_PATH
        mov rax, 60;                              // SC+ ID 60 = sys_exit
        syscall;

      mkdir_after_operand_ok:
        // ---- Step 7 (M1-003): walk positionals. ----
        call mkdir_run;

        // ---- Step 8: sys_exit(MkdirState::exit_code). 0 on all-success. ----
        lea r11, [rip + exit_code];
        mov rdi, [r11];
        mov rax, 60;                              // SC+ ID 60 = sys_exit
        syscall;

        // Defensive belt-and-suspenders — sys_exit never returns.
      mkdir_unreachable:
        jmp mkdir_unreachable;
      }
    }
}
